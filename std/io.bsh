#!/usr/bin/env bettersh

# Writes text to stdout without a newline.
fn write(text) {
  print(text)
}

# Writes text to stdout and then a newline.
fn writeln(text) {
  println(text)
}

# Writes text to stderr and then a newline.
fn error(text) {
  eprintln(text)
}

# Reads one line from stdin. A trailing CR or LF is dropped. End of file is null.
fn read() {
  return readln()
}

# Splits text on each newline. The separator is not kept.
fn lines(text) {
  return text.split("\n")
}
