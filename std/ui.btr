#!/usr/bin/env bettersh

import std/strings

# Returns n, or 1 when n is below 1.
fn clamp_size(n) {
  if n < 1 { return 1 }
  return n
}

# Returns a screen of rows lines, each cols spaces. A size below 1 becomes 1.
fn blank(cols, rows) {
  let cols = clamp_size(cols)
  let rows = clamp_size(rows)
  let row = strings.repeat(" ", cols)
  let grid = []
  let i = 0
  while i < rows {
    let grid = grid.push(row)
    let i = i + 1
  }
  return { cols: cols, rows: rows, grid: grid }
}

# Writes text into row at col and clips it to the row. A column outside the row leaves the row unchanged.
fn splice(row, col, text) {
  if col < 0 || col >= row.length || text.length == 0 { return row }
  let room = row.length - col
  if text.length > room { let text = strings.slice(text, 0, room) }
  let end = col + text.length
  return "@{ strings.slice(row, 0, col) }@{ text }@{ strings.slice(row, end, row.length) }"
}

# Returns a copy of screen with text written at row, col. A row outside the screen is unchanged.
fn put(screen, row, col, text) {
  if row < 0 || row >= screen.rows { return screen }
  let grid = []
  let i = 0
  while i < screen.rows {
    let line = screen.grid[i]
    if i == row { let line = splice(line, col, text) }
    let grid = grid.push(line)
    let i = i + 1
  }
  return { cols: screen.cols, rows: screen.rows, grid: grid }
}

# Returns "+" followed by inner dashes and "+".
fn rule(inner) {
  return "+@{ strings.repeat("-", inner) }+"
}

# Returns a top rule with title. An empty title, or one that does not fit, is a plain rule.
fn top_rule(inner, title) {
  if title.length == 0 || title.length + 2 > inner { return rule(inner) }
  let dashes = inner - title.length - 2
  return "+ @{ title } @{ strings.repeat("-", dashes) }+"
}

# Draws a box of height h and width w on a copy of screen. A size below 2 leaves the screen unchanged.
fn box(screen, row, col, h, w, title) {
  if h < 2 || w < 2 { return screen }
  let inner = w - 2
  let screen = put(screen, row, col, top_rule(inner, title))
  let mid = "|@{ strings.repeat(" ", inner) }|"
  let i = 1
  while i < h - 1 {
    let screen = put(screen, row + i, col, mid)
    let i = i + 1
  }
  return put(screen, row + h - 1, col, rule(inner))
}

# Joins the screen rows with newlines.
fn paint(screen) {
  return screen.grid.join("\n")
}

# Returns one key event: key is the name, pending is an unfinished escape, and extra is a byte to feed again.
fn event(key, pending, extra) {
  return { key: key, pending: pending, extra: extra }
}

# Returns how many bytes a lead byte needs, or 0 when it is not a lead.
fn utf_need(n) {
  if n >= 194 && n <= 223 { return 2 }
  if n >= 224 && n <= 239 { return 3 }
  if n >= 240 && n <= 244 { return 4 }
  return 0
}

# Finishes a UTF-8 sequence, or emits the lead byte and hands the rest back.
fn feed_utf(pending, byte) {
  let n = ord(byte)
  if n < 128 || n >= 192 {
    let rest = byte
    if pending.length > 1 { let rest = "@{ strings.slice(pending, 1, pending.length) }@{ byte }" }
    return event(pending[0], "", rest)
  }
  let seq = "@{ pending }@{ byte }"
  let need = utf_need(ord(pending[0]))
  if seq.length == 1 { return event(seq, "", null) }
  if seq.length >= need { return event(seq[0], "", strings.slice(seq, 1, seq.length)) }
  return event(null, seq, null)
}

# Names one byte. Enter, backspace, tab, and the editing ctrl keys have names. Escape and a UTF-8 lead start a pending sequence.
fn plain(byte) {
  let n = ord(byte)
  if n == 10 || n == 13 { return event("enter", "", null) }
  if n == 127 || n == 8 { return event("backspace", "", null) }
  if n == 9 { return event("tab", "", null) }
  if n == 3 { return event("ctrl-c", "", null) }
  if n == 4 { return event("ctrl-d", "", null) }
  if n == 14 { return event("ctrl-n", "", null) }
  if n == 16 { return event("ctrl-p", "", null) }
  if n == 18 { return event("ctrl-r", "", null) }
  if n == 19 { return event("ctrl-s", "", null) }
  if n == 20 { return event("ctrl-t", "", null) }
  if n == 21 { return event("ctrl-u", "", null) }
  if n == 23 { return event("ctrl-w", "", null) }
  if n == 24 { return event("ctrl-x", "", null) }
  if n == 25 { return event("ctrl-y", "", null) }
  if n == 26 { return event("ctrl-z", "", null) }
  if n == 31 { return event("ctrl-/", "", null) }
  if n == 27 { return event(null, byte, null) }
  if utf_need(n) > 0 { return event(null, byte, null) }
  if (n >= 32 && n <= 126) || n >= 128 { return event(byte, "", null) }
  return event(null, "", null)
}

# Names a finished escape sequence, or "" when it is not a known key.
fn named(seq) {
  let esc = chr(27)
  if seq == "@{ esc }[A" || seq == "@{ esc }OA" { return "up" }
  if seq == "@{ esc }[B" || seq == "@{ esc }OB" { return "down" }
  if seq == "@{ esc }[C" || seq == "@{ esc }OC" { return "right" }
  if seq == "@{ esc }[D" || seq == "@{ esc }OD" { return "left" }
  if seq == "@{ esc }[H" { return "home" }
  if seq == "@{ esc }[F" { return "end" }
  if seq == "@{ esc }[3~" { return "delete" }
  if seq == "@{ esc }[5~" { return "pageup" }
  if seq == "@{ esc }[6~" { return "pagedown" }
  return ""
}

# Feeds one byte into pending and returns the next event. A byte that is not one character leaves pending unchanged.
fn feed(pending, byte) {
  if byte == null || byte.length != 1 { return event(null, pending, null) }
  let esc = chr(27)
  if pending.length > 0 && ord(pending[0]) >= 128 { return feed_utf(pending, byte) }
  if pending.length == 0 { return plain(byte) }
  if pending == esc && byte != "[" && byte != "O" {
    return event("escape", "", byte)
  }
  let seq = "@{ pending }@{ byte }"
  if seq == "@{ esc }[" || seq == "@{ esc }O" || seq == "@{ esc }[3" || seq == "@{ esc }[5" || seq == "@{ esc }[6" {
    return event(null, seq, null)
  }
  let key = named(seq)
  if key.length > 0 { return event(key, "", null) }
  return event(null, "", null)
}

# Turns a leftover escape into the escape key. A partial UTF-8 sequence becomes its first byte.
fn flush(pending) {
  if pending == chr(27) { return event("escape", "", null) }
  if pending.length > 0 && ord(pending[0]) >= 128 {
    let rest = null
    if pending.length > 1 { let rest = strings.slice(pending, 1, pending.length) }
    return event(pending[0], "", rest)
  }
  return event(null, "", null)
}

# Returns true when cp is a combining mark or a zero-width control.
fn zero_width(cp) {
  if cp >= 768 && cp <= 879 { return true }
  if cp >= 1155 && cp <= 1161 { return true }
  if cp >= 1425 && cp <= 1469 { return true }
  if cp == 1471 || cp == 1473 || cp == 1474 || cp == 1476 || cp == 1477 || cp == 1479 { return true }
  if cp >= 1552 && cp <= 1562 { return true }
  if cp >= 1611 && cp <= 1631 { return true }
  if cp == 1648 { return true }
  if cp >= 1750 && cp <= 1773 { return true }
  if cp >= 8400 && cp <= 8447 { return true }
  if cp >= 65024 && cp <= 65039 { return true }
  if cp >= 65056 && cp <= 65071 { return true }
  if cp == 8203 || cp == 8204 || cp == 8205 || cp == 65279 { return true }
  return false
}

# Returns true when a terminal draws cp in two columns.
fn wide(cp) {
  if cp >= 4352 && cp <= 4447 { return true }
  if cp == 9001 || cp == 9002 { return true }
  if cp >= 11904 && cp <= 42191 && cp != 12351 { return true }
  if cp >= 44032 && cp <= 55203 { return true }
  if cp >= 63744 && cp <= 64255 { return true }
  if cp >= 65040 && cp <= 65049 { return true }
  if cp >= 65072 && cp <= 65135 { return true }
  if cp >= 65280 && cp <= 65376 { return true }
  if cp >= 65504 && cp <= 65510 { return true }
  if cp >= 127744 && cp <= 128591 { return true }
  if cp >= 129280 && cp <= 129535 { return true }
  if cp >= 131072 && cp <= 262141 { return true }
  return false
}

# Returns the display columns of one visible character that starts at col.
fn cell(ch, col) {
  if ch == "\t" {
    let step = 8 - (col % 8)
    return step
  }
  let n = ord(ch)
  if zero_width(n) { return 0 }
  if wide(n) { return 2 }
  return 1
}

# Returns the display columns of the first n scalars. Tab stops count from the start of text.
fn width_at(text, n) {
  let shown = text.visible()
  if n < 0 { let n = 0 }
  if n > shown.length { let n = shown.length }
  let col = 0
  let i = 0
  while i < n {
    let col = col + cell(shown[i], col)
    let i = i + 1
  }
  return col
}

# Returns the display columns of text.
fn width(text) {
  return width_at(text, text.length)
}

# Returns the display columns of the scalar at index, at least 1.
fn span(text, index) {
  let shown = text.visible()
  if index < 0 || index >= shown.length { return 1 }
  let at = width_at(shown, index)
  let w = cell(shown[index], at)
  if w < 1 { return 1 }
  return w
}

# Returns the visible text from column left for room columns. A tab is spaces.
fn take(text, left, room) {
  if room < 1 { return "" }
  let shown = text.visible()
  let out = ""
  let col = 0
  let used = 0
  let i = 0
  while i < shown.length && used < room {
    let ch = shown[i]
    let w = cell(ch, col)
    let next = col + w
    if col >= left || next > left {
      if col < left {
        let gap = next - left
        if used + gap > room { let gap = room - used }
        if gap > 0 {
          let out = "@{ out }@{ strings.repeat(" ", gap) }"
          let used = used + gap
        }
      } else if w == 0 {
        let out = "@{ out }@{ ch }"
      } else if used + w <= room {
        let piece = ch
        if ch == "\t" { let piece = strings.repeat(" ", w) }
        let out = "@{ out }@{ piece }"
        let used = used + w
      } else {
        return out
      }
    }
    let col = next
    let i = i + 1
  }
  return out
}
