#!/usr/bin/env bettersh

import std/strings
import std/edit_text
import std/edit_syntax

# Completions. A .btr buffer completes names from the built-in catalog and its own fn, let,
# and import lines. Every buffer completes words that already appear in it.
# The inserted text is only the identifier under the cursor. A dot stays put.

let table_hold = []
let memo = { n: 0, locals: {}, words: {} }

fn catalog() {
