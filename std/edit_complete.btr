fn table() {
  if table_hold.length == 2 { return { book: table_hold[0], names: table_hold[1] } }
  let book = {}
  let names = []
  let rows = catalog()
  let i = 0
  while i < rows.length {
    let row = rows[i]
    let cut = row.index("|")
    if cut > 0 {
      let name = row.slice(0, cut)
      let blurb = row.slice(cut + 1, row.length)
      if name != "" && !book.has(name) {
        let book = map_set(book, name, blurb)
        let names = names.push(name)
      }
    }
    let i = i + 1
  }
  let junk = table_hold.push(book)
  let junk = table_hold.push(names)
  return { book: book, names: names }
}

fn last_dot(name) {
  let base = 0
  let last = 0 - 1
  let rest = name
  let at = rest.index(".")
  while at >= 0 {
    let last = base + at
    let base = last + 1
    let rest = name.slice(base, name.length)
    let at = rest.index(".")
  }
  return last
}

fn tail_of(name) {
  let at = last_dot(name)
  if at < 0 { return name }
  return name.slice(at + 1, name.length)
}

fn head_of(name) {
  let at = last_dot(name)
  if at < 0 { return "" }
  return name.slice(0, at)
}

fn trim_left(text) {
  let i = 0
  while i < text.length && (text[i] == " " || text[i] == "\t") { let i = i + 1 }
  return text.slice(i, text.length)
}

fn read_ident(text, i) {
  let a = i
  while i < text.length && edit_text.is_word(text[i]) { let i = i + 1 }
  if i == a { return "" }
  return text.slice(a, i)
}

fn read_fn(text) {
  let i = 3
  while i < text.length && text[i] == " " { let i = i + 1 }
  let name = read_ident(text, i)
  if name == "" { return null }
  let i = i + name.length
  while i < text.length && text[i] == " " { let i = i + 1 }
  let blurb = name
  if i < text.length && text[i] == "(" {
    let j = i
    while j < text.length && text[j] != ")" && text[j] != "{" { let j = j + 1 }
    if j < text.length && text[j] == ")" { let blurb = "@{ name }@{ text.slice(i, j + 1) }" }
  }
  return { name: name, blurb: blurb }
}

fn read_let(text) {
  let i = 4
  while i < text.length && text[i] == " " { let i = i + 1 }
  let name = read_ident(text, i)
  if name == "" { return null }
  return { name: name, blurb: "let @{ name }" }
}

fn read_import(text) {
  let rest = trim_left(text.slice(7, text.length))
  if rest.contains(" as ") {
    let parts = rest.split(" as ")
    let alias = trim_left(parts[parts.length - 1])
    let name = read_ident(alias, 0)
    if name == "" { return null }
    return { name: name, blurb: "import @{ name }" }
  }
  if strings.starts(rest, "std/") {
    let body = rest.slice(4, rest.length)
    let raw = ""
    let i = 0
    while i < body.length && body[i] != " " && body[i] != "\t" && body[i] != "#" {
      let raw = "@{ raw }@{ body[i] }"
      let i = i + 1
    }
    let name = tail_of(raw)
    if name == "" { return null }
    return { name: name, blurb: "import std/@{ raw }" }
  }
  return null
}

fn one_local(text) {
  let text = trim_left(text)
  let got = null
  if strings.starts(text, "fn ") { let got = read_fn(text) }
  else if strings.starts(text, "let ") { let got = read_let(text) }
  else if strings.starts(text, "import ") { let got = read_import(text) }
  if got == null || got.name == "" { return null }
  return got
}

fn forget() {
  let junk = map_set(memo, "locals", {})
  let junk = map_set(memo, "words", {})
  let junk = map_set(memo, "n", 0)
}

# Line text to its declaration, or false. Text with a zero byte is not a map key.
fn local_of(text) {
  let book = memo.locals
  if book.has(text) { return book[text] }
  let got = one_local(text)
  let keep = got
  if got == null { let keep = false }
  if text.index(chr(0)) < 0 {
    if memo.n > 50000 { forget() }
    let junk = map_set(memo.locals, text, keep)
    let junk = map_set(memo, "n", memo.n + 1)
  }
  return keep
}

# Declarations in the file. The first one of each name wins.
fn locals(lines) {
  let out = []
  let seen = {}
  let i = 0
  while i < lines.length {
    let got = local_of(lines[i])
    if got != false && !seen.has(got.name) {
      let junk = map_set(seen, got.name, true)
      let out = out.push(got)
    }
    let i = i + 1
  }
  return out
}

fn lookup(lines, name) {
  if name == "" { return "" }
  let book = table().book
  if book.has(name) { return book[name] }
  if name[0] != "." {
    let dot = ".@{ name }"
    if book.has(dot) { return book[dot] }
  }
  let want = tail_of(name)
  let found = locals(lines)
  let i = 0
  while i < found.length {
    if found[i].name == name || found[i].name == want { return found[i].blurb }
    let i = i + 1
  }
  if want != name && book.has(want) { return book[want] }
  if want != name {
    let dot = ".@{ want }"
    if book.has(dot) { return book[dot] }
  }
  return ""
}

# The identifier, with dots, that ends at col.
fn prefix_at(line, col) {
  if col < 0 { let col = 0 }
  if col > line.length { let col = line.length }
  let i = col
  let going = true
  while going && i > 0 {
    let ch = line[i - 1]
    if edit_text.is_word(ch) || ch == "." { let i = i - 1 }
    else { let going = false }
  }
  return line.slice(i, col)
}

# True when the scalar before col is inside a string or a comment.
fn in_literal(marks, col) {
  if col <= 0 || marks == null { return false }
  let at = col - 1
  if at >= marks.length { return false }
  let mark = marks[at]
  return edit_syntax.literal(mark)
}

fn call_name(line, paren) {
  let i = paren
  while i > 0 && (line[i - 1] == " " || line[i - 1] == "\t") { let i = i - 1 }
  let b = i
  let going = true
  while going && i > 0 {
    let ch = line[i - 1]
    if edit_text.is_word(ch) || ch == "." { let i = i - 1 }
    else { let going = false }
  }
  return line.slice(i, b)
}

# The signature of the call the caret is inside, or "".
fn call_hint(lines, row, col, marks) {
  let line = lines[row]
  let depth = 0
  let i = col
  if i > line.length { let i = line.length }
  while i > 0 {
    let i = i - 1
    let skip = false
    if marks != null && i < marks.length {
      if edit_syntax.literal(marks[i]) { let skip = true }
    }
    if !skip {
      if line[i] == ")" { let depth = depth + 1 }
      if line[i] == "(" {
        if depth == 0 { return lookup(lines, call_name(line, i)) }
        let depth = depth - 1
      }
    }
  }
  return ""
}

fn tag(name) {
  return " @{ name }"
}

fn blurb_of(book, extra, name, head) {
  let marked = tag(name)
  if extra.has(marked) { return extra[marked] }
  if book.has(name) { return book[name] }
  if head != "" {
    let key = "@{ head }.@{ name }"
    if book.has(key) { return book[key] }
  }
  let key = ".@{ name }"
  if book.has(key) { return book[key] }
  return name
}

fn remember(seen, extra, hit, name, blurb) {
  if name == "" { return { seen: seen, extra: extra, hit: hit } }
  let marked = tag(name)
  if seen.has(marked) { return { seen: seen, extra: extra, hit: hit } }
  let seen = map_set(seen, marked, true)
  if blurb != "" { let extra = map_set(extra, marked, blurb) }
  let hit = hit.push(name)
  return { seen: seen, extra: extra, hit: hit }
}

# Catalog and declaration names that start with the prefix before col.
fn collect(lines, row, col) {
  let prefix = prefix_at(lines[row], col)
  if prefix == "" { return [] }
  let head = head_of(prefix)
  let tail = tail_of(prefix)
  let method = prefix[0] == "." && head == ""
  let got = table()
  let book = got.book
  let names = got.names
  let known = head != "" && book.has(head)
  let hit = []
  let extra = {}
  let seen = {}
  if !method && head == "" {
    let found = locals(lines)
    let i = 0
    while i < found.length {
      let item = found[i]
      if strings.starts(item.name, prefix) {
        let kept = remember(seen, extra, hit, item.name, item.blurb)
        let seen = kept.seen
        let extra = kept.extra
        let hit = kept.hit
      }
      let i = i + 1
    }
  }
  let i = 0
  while i < names.length {
    let name = names[i]
    let take = ""
    if method {
      if name[0] == "." && strings.starts(name.slice(1, name.length), tail) {
        let take = name.slice(1, name.length)
      }
    } else if head != "" {
      if strings.starts(name, "@{ head }.") && strings.starts(tail_of(name), tail) {
        let take = tail_of(name)
      } else if !known && name[0] == "." && strings.starts(name.slice(1, name.length), tail) {
        let take = name.slice(1, name.length)
      }
    } else if name[0] != "." {
      if strings.starts(name, prefix) { let take = name }
      else if name.contains(".") && strings.starts(tail_of(name), prefix) { let take = name }
    }
    if take != "" {
      let kept = remember(seen, extra, hit, take, "")
      let seen = kept.seen
      let extra = kept.extra
      let hit = kept.hit
    }
    let i = i + 1
  }
  # Plain names come before dotted ones, each group sorted.
  let keyed = []
  let j = 0
  while j < hit.length {
    let rank = "0"
    if hit[j].contains(".") { let rank = "1" }
    let keyed = keyed.push("@{ rank }@{ hit[j] }")
    let j = j + 1
  }
  let keyed = keyed.sort()
  let out = []
  let n = keyed.length
  if n > 12 { let n = 12 }
  let j = 0
  while j < n {
    let name = keyed[j].slice(1, keyed[j].length)
    let out = out.push({ name: name, blurb: blurb_of(book, extra, name, head) })
    let j = j + 1
  }
  return out
}

# The identifiers in a line of text, cached by the text.
fn words_of(text) {
  let book = memo.words
  if book.has(text) { return book[text] }
  let out = []
  let i = 0
  let n = text.length
  while i < n {
    if edit_text.is_word(text[i]) && !edit_text.is_digit(text[i]) {
      let j = i + 1
      while j < n && edit_text.is_word(text[j]) { let j = j + 1 }
      if j - i >= 3 { let out = out.push(text.slice(i, j)) }
      let i = j
    } else if edit_text.is_word(text[i]) {
      let j = i + 1
      while j < n && edit_text.is_word(text[j]) { let j = j + 1 }
      let i = j
    } else {
      let i = i + 1
    }
  }
  if text.index(chr(0)) < 0 {
    if memo.n > 50000 { forget() }
    let junk = map_set(memo.words, text, out)
    let junk = map_set(memo, "n", memo.n + 1)
  }
  return out
}

# Words within 800 lines of row that fuzzy-match the identifier before col, best first. The word being typed is left out.
fn buffer_words(lines, row, col, limit) {
  let line = lines[row]
  let r = edit_text.ident_range(line, col)
  let prefix = line.slice(r.a, col)
  if prefix.length < 2 { return [] }
  let typed = line.slice(r.a, r.b)
  let seen = {}
  let found = []
  let lo = row - 800
  if lo < 0 { let lo = 0 }
  let hi = row + 800
  if hi > lines.length { let hi = lines.length }
  let i = lo
  while i < hi {
    let list = words_of(lines[i])
    let k = 0
    while k < list.length {
      let w = list[k]
      if w != typed && w != prefix && !seen.has(w) && w[0].lower() == prefix[0].lower() {
        let score = edit_text.fuzzy(prefix, w)
        if score > 0 {
          let near = row - i
          if near < 0 { let near = 0 - near }
          let score = score * 4 - near / 50
          if score < 1 { let score = 1 }
          let junk = map_set(seen, w, true)
          let found = found.push({ name: w, blurb: "", score: score })
        }
      }
      let k = k + 1
    }
    let i = i + 1
  }
  let found = edit_text.by_score(found)
  if found.length > limit { let found = found.slice(0, limit) }
  return found
}

# The completion rows and the signature hint for this caret. marks are the row's syntax marks.
fn offer(lines, row, col, marks, lang) {
  if lines == null || row < 0 || row >= lines.length { return { items: [], hint: "" } }
  if in_literal(marks, col) { return { items: [], hint: "" } }
  let items = []
  let sig = ""
  if lang == "btr" {
    let sig = call_hint(lines, row, col, marks)
    let items = collect(lines, row, col)
  }
  let have = {}
  let i = 0
  while i < items.length {
    let junk = map_set(have, items[i].name, true)
    let i = i + 1
  }
  let extra = buffer_words(lines, row, col, 12)
  let i = 0
  while i < extra.length && items.length < 12 {
    if !have.has(extra[i].name) { let items = items.push({ name: extra[i].name, blurb: "" }) }
    let i = i + 1
  }
  if sig != "" && prefix_at(lines[row], col) == "" { return { items: [], hint: sig } }
  return { items: items, hint: sig }
}

fn word_at(line, col) {
  if line.length == 0 { return "" }
  if col < 0 { let col = 0 }
  if col >= line.length { let col = line.length - 1 }
  if col < 0 { return "" }
  if !edit_text.is_word(line[col]) {
    if col > 0 && edit_text.is_word(line[col - 1]) { let col = col - 1 }
    else { return "" }
  }
  let a = col
  let b = col + 1
  while a > 0 && (edit_text.is_word(line[a - 1]) || line[a - 1] == ".") { let a = a - 1 }
  while b < line.length && (edit_text.is_word(line[b]) || line[b] == ".") { let b = b + 1 }
  return line.slice(a, b)
}

# Returns the signature of the word under the cursor, or "".
fn hover_text(lines, row, col, marks) {
  if lines == null || row < 0 || row >= lines.length { return "" }
  if in_literal(marks, col + 1) { return "" }
  return lookup(lines, word_at(lines[row], col))
}

fn find_fn(lines, name) {
  if name == "" { return null }
  let i = 0
  while i < lines.length {
    let raw = lines[i]
    let text = trim_left(raw)
    if strings.starts(text, "fn ") {
      let got = read_fn(text)
      if got != null && got.name == name {
        let pad = raw.length - text.length
        let col = pad + 3
        while col < raw.length && (raw[col] == " " || raw[col] == "\t") { let col = col + 1 }
        return { row: i, col: col }
      }
    }
    let i = i + 1
  }
  return null
}

# Returns the row and column of fn for the word under the cursor, or null.
fn jump_at(lines, row, col) {
  if lines == null || row < 0 || row >= lines.length { return null }
  let word = word_at(lines[row], col)
  if word == "" { return null }
  return find_fn(lines, tail_of(word))
}
