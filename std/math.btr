#!/usr/bin/env bettersh

# Returns n, or its negation when n is negative.
fn abs(n) {
  if n < 0 { return 0 - n }
  return n
}

# Returns the lesser of a and b.
fn min(a, b) {
  if a < b { return a }
  return b
}

# Returns the greater of a and b.
fn max(a, b) {
  if a > b { return a }
  return b
}

# Returns n limited to the inclusive range from lo to hi.
fn clamp(n, lo, hi) {
  if n < lo { return lo }
  if n > hi { return hi }
  return n
}

# Returns 1 when n is positive, -1 when it is negative, and 0 when it is zero.
fn sign(n) {
  if n > 0 { return 1 }
  if n < 0 { return 0 - 1 }
  return 0
}

# Returns the greatest common divisor of a and b. Both arguments are taken as absolute values.
fn gcd(a, b) {
  let a = abs(a)
  let b = abs(b)
  while b != 0 {
    let t = a % b
    let a = b
    let b = t
  }
  return a
}

# Returns the least common multiple of a and b, or 0 when either argument is 0.
fn lcm(a, b) {
  if a == 0 || b == 0 { return 0 }
  return abs(a / gcd(a, b) * b)
}

# Returns base raised to exp. A negative exp uses libm. A non-negative exp is repeated multiplication.
fn pow(base, exp) {
  if exp < 0 { return mathf("pow", base, exp) }
  let out = 1
  let i = 0
  while i < exp {
    let out = out * base
    let i = i + 1
  }
  return out
}

# Returns n factorial, or null when n is negative.
fn fact(n) {
  if n < 0 { return null }
  let out = 1
  let i = 2
  while i <= n {
    let out = out * i
    let i = i + 1
  }
  return out
}

# Returns the square root of x.
fn sqrt(x) { return mathf("sqrt", x) }
# Returns the sine of x in radians.
fn sin(x) { return mathf("sin", x) }
# Returns the cosine of x in radians.
fn cos(x) { return mathf("cos", x) }
# Returns the tangent of x in radians.
fn tan(x) { return mathf("tan", x) }
# Returns the arc sine of x in radians.
fn asin(x) { return mathf("asin", x) }
# Returns the arc cosine of x in radians.
fn acos(x) { return mathf("acos", x) }
# Returns the arc tangent of x in radians.
fn atan(x) { return mathf("atan", x) }
# Returns the arc tangent of y/x, using the signs of both arguments to choose the quadrant.
fn atan2(y, x) { return mathf("atan2", y, x) }
# Returns the greatest integer less than or equal to x.
fn floor(x) { return mathf("floor", x) }
# Returns the least integer greater than or equal to x.
fn ceil(x) { return mathf("ceil", x) }
# Returns x rounded to the nearest integer.
fn round(x) { return mathf("round", x) }
# Returns the natural logarithm of x.
fn log(x) { return mathf("log", x) }
# Returns e raised to x.
fn exp(x) { return mathf("exp", x) }
# Returns the square root of x*x + y*y.
fn hypot(x, y) { return mathf("hypot", x, y) }
# Returns the base-10 logarithm of x.
fn log10(x) { return mathf("log10", x) }
# Returns the base-2 logarithm of x.
fn log2(x) { return mathf("log2", x) }
# Returns the cube root of x.
fn cbrt(x) { return mathf("cbrt", x) }
# Returns 2 raised to x.
fn exp2(x) { return mathf("exp2", x) }
# Returns e raised to x, minus 1.
fn expm1(x) { return mathf("expm1", x) }
# Returns the natural logarithm of 1 + x.
fn log1p(x) { return mathf("log1p", x) }
# Returns x with the fractional part removed, toward zero.
fn trunc(x) { return mathf("trunc", x) }
# Returns the hyperbolic sine of x.
fn sinh(x) { return mathf("sinh", x) }
# Returns the hyperbolic cosine of x.
fn cosh(x) { return mathf("cosh", x) }
# Returns the hyperbolic tangent of x.
fn tanh(x) { return mathf("tanh", x) }
# Returns the inverse hyperbolic sine of x.
fn asinh(x) { return mathf("asinh", x) }
# Returns the inverse hyperbolic cosine of x.
fn acosh(x) { return mathf("acosh", x) }
# Returns the inverse hyperbolic tangent of x.
fn atanh(x) { return mathf("atanh", x) }
# Returns the gamma of x. gamma(n) for a positive integer n is (n - 1)!.
fn tgamma(x) { return mathf("tgamma", x) }
# Returns the natural logarithm of the absolute value of gamma(x).
fn lgamma(x) { return mathf("lgamma", x) }
# Returns the remainder of x divided by y. y == 0 is an error. This accepts a float. The % operator does not.
fn fmod(x, y) { return mathf("fmod", x, y) }
# Returns the IEEE remainder of x divided by y.
fn remainder(x, y) { return mathf("remainder", x, y) }
# Returns a number with the magnitude of x and the sign of y.
fn copysign(x, y) { return mathf("copysign", x, y) }

# Returns pi.
fn pi() { return mathf("acos", 0 - 1) }
# Returns e.
fn e() { return mathf("exp", 1) }
# Returns 2 * pi.
fn tau() { return pi() * 2 }

# Returns radians converted to degrees.
fn deg(radians) {
  return radians * 180.0 / pi()
}

# Returns degrees converted to radians.
fn rad(degrees) {
  return degrees * pi() / 180.0
}

# Returns x rounded so that digits places remain. A negative digits rounds to a power of ten.
fn round_to(x, digits) {
  let p = pow(10, digits)
  return mathf("round", x * p) / p
}

# Returns a + (b - a) * t.
fn lerp(a, b, t) {
  return a + (b - a) * t
}

# Returns the sum of the numbers in xs. An empty array is 0.
fn sum(xs) {
  let out = 0
  let i = 0
  while i < xs.length {
    let out = out + xs[i]
    let i = i + 1
  }
  return out
}

# Returns the mean of xs, or null when xs is empty. The result is a float.
fn mean(xs) {
  if xs.length == 0 { return null }
  return sum(xs) * 1.0 / xs.length
}

# Returns the middle value of xs, or the mean of the two middle values when the length is even. An empty array is null.
fn median(xs) {
  if xs.length == 0 { return null }
  let s = xs.sort()
  let n = s.length
  let mid = n / 2
  if n % 2 == 1 { return s[mid] }
  return (s[mid - 1] + s[mid]) * 1.0 / 2
}

# Returns the binomial coefficient n choose k. A negative argument is null. k > n is 0.
fn choose(n, k) {
  if n < 0 || k < 0 { return null }
  if k > n { return 0 }
  if k > n - k { let k = n - k }
  let out = 1
  let i = 1
  while i <= k {
    let out = out * (n - k + i) / i
    let i = i + 1
  }
  return out
}
