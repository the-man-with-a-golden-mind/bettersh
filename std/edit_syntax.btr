#!/usr/bin/env bettersh

import std/path

# Marks for one source line.
# c comment, s string, k keyword, n number, f function, t type, o constant, m macro, v variable, . plain.
# The language comes from the file extension. An unknown extension stays plain.
# A block comment or a string that is still open keeps going on the next line.
# State F means the next identifier is a function name.

fn lang(file) {
  if file == null { return "" }
  let ext = path.ext(file)
  if ext == "js" || ext == "mjs" || ext == "cjs" || ext == "jsx" { return "js" }
  if ext == "ts" || ext == "tsx" || ext == "mts" || ext == "cts" { return "ts" }
  if ext == "rs" { return "rust" }
  if ext == "sh" || ext == "bash" || ext == "bsh" { return "sh" }
  if ext == "btr" { return "btr" }
  if ext == "py" { return "py" }
  if ext == "lua" { return "lua" }
  return ""
}

fn words(which) {
  if which == "btr" { return "let fn if else while for return import case in" }
  if which == "js" { return "await break case catch class const continue debugger default delete do else export extends false finally for function if import in instanceof let new null return static super switch this throw true try typeof var void while with yield async" }
  if which == "ts" { return "abstract as asserts declare enum implements infer interface is keyof namespace never readonly type unique unknown override" }
  if which == "rust" { return "as async await break const continue crate dyn else enum extern false fn for if impl in let loop match mod move mut pub ref return self Self static struct super trait true type unsafe use where while" }
  if which == "sh" { return "if then else elif fi case esac for while until do done in function select time" }
  if which == "py" { return "False None True and as assert async await break case class continue def del elif else except finally for from global if import in is lambda match nonlocal not or pass raise return try while with yield" }
  if which == "lua" { return "and break do else elseif end false for function goto if in local nil not or repeat return then true until while" }
  return ""
}

fn listed(words, word) {
  let text = " @{ words } "
  return text.contains(" @{ word } ")
}

fn is_kw(which, word) {
  if which == "ts" {
    if listed(words("js"), word) { return true }
    return listed(words("ts"), word)
  }
  return listed(words(which), word)
}

fn is_ident(ch) {
  if ch >= "a" && ch <= "z" { return true }
  if ch >= "A" && ch <= "Z" { return true }
  if ch >= "0" && ch <= "9" { return true }
  if ch == "_" { return true }
  return false
}

fn is_digit(ch) {
  if ch >= "0" && ch <= "9" { return true }
  return false
}

fn is_hex(ch) {
  if is_digit(ch) { return true }
  if ch >= "a" && ch <= "f" { return true }
  if ch >= "A" && ch <= "F" { return true }
  return false
}

fn push(parts, keep, mark) {
  if !keep { return parts }
  return parts.push(mark)
}

fn fill(parts, keep, mark, from, to) {
  while from < to {
    let parts = push(parts, keep, mark)
    let from = from + 1
  }
  return parts
}

fn num_arg(state) {
  let n = 0
  let i = 1
  while i < state.length {
    let n = n * 10 + (ord(state[i]) - 48)
    let i = i + 1
  }
  return n
}

fn lua_open(line, i) {
  if i >= line.length || line[i] != "[" { return null }
  let j = i + 1
  let n = 0
  while j < line.length && line[j] == "=" {
    let n = n + 1
    let j = j + 1
  }
  if j < line.length && line[j] == "[" { return { at: j + 1, n: n } }
  return null
}

fn lua_end(line, i, n) {
  if i >= line.length || line[i] != "]" { return 0 - 1 }
  let j = i + 1
  let k = 0
  while k < n && j < line.length && line[j] == "=" {
    let j = j + 1
    let k = k + 1
  }
  if k == n && j < line.length && line[j] == "]" { return j + 1 }
  return 0 - 1
}

fn raw_end(line, i, n) {
  if i >= line.length || line[i] != "\"" { return 0 - 1 }
  let j = i + 1
  let k = 0
  while k < n && j < line.length && line[j] == "#" {
    let j = j + 1
    let k = k + 1
  }
  if k == n { return j }
  return 0 - 1
}

fn finish_exp(line, i, which) {
  if i < line.length && (line[i] == "e" || line[i] == "E") {
    let j = i + 1
    if j < line.length && (line[j] == "+" || line[j] == "-") { let j = j + 1 }
    if j < line.length && is_digit(line[j]) {
      let i = j
      while i < line.length && (is_digit(line[i]) || line[i] == "_") { let i = i + 1 }
    }
  }
  if which == "rust" {
    while i < line.length && is_ident(line[i]) { let i = i + 1 }
  }
  return i
}

fn take_num(line, i, which) {
  if line[i] == "0" && i + 1 < line.length {
    let k = line[i + 1]
    if k == "x" || k == "X" || k == "b" || k == "B" || k == "o" || k == "O" {
      let i = i + 2
      while i < line.length && (is_hex(line[i]) || line[i] == "_") { let i = i + 1 }
      return finish_exp(line, i, which)
    }
  }
  if line[i] == "." {
    let i = i + 1
    while i < line.length && (is_digit(line[i]) || line[i] == "_") { let i = i + 1 }
    return finish_exp(line, i, which)
  }
  while i < line.length && (is_digit(line[i]) || line[i] == "_") { let i = i + 1 }
  if i + 1 < line.length && line[i] == "." && line[i + 1] != "." && is_digit(line[i + 1]) {
    let i = i + 1
    while i < line.length && (is_digit(line[i]) || line[i] == "_") { let i = i + 1 }
  }
  return finish_exp(line, i, which)
}

fn rust_open(line, i) {
  if i >= line.length { return null }
  if line[i] != "r" && line[i] != "b" { return null }
  let j = i
  if line[j] == "b" { let j = j + 1 }
  let raw = false
  if j < line.length && line[j] == "r" {
    let raw = true
    let j = j + 1
  }
  if j == i { return null }
  let hashes = 0
  if raw {
    while j < line.length && line[j] == "#" {
      let hashes = hashes + 1
      let j = j + 1
    }
  }
  if j >= line.length || line[j] != "\"" { return null }
  let j = j + 1
  if raw { return { at: j, state: "w@{ hashes }" } }
  return { at: j, state: "q\"" }
}

fn prefix_ok(word) {
  if word.length == 0 || word.length > 3 { return false }
  let i = 0
  while i < word.length {
    let ch = word[i].lower()
    if ch != "r" && ch != "u" && ch != "b" && ch != "f" { return false }
    let i = i + 1
  }
  return true
}

fn open_py(line, i, raw) {
  let q = line[i]
  let triple = false
  if i + 2 < line.length && line[i + 1] == q && line[i + 2] == q { let triple = true }
  if triple {
    if raw { return { at: i + 3, state: "u@{ q }" } }
    return { at: i + 3, state: "p@{ q }" }
  }
  if raw { return { at: i + 1, state: "r@{ q }" } }
  return { at: i + 1, state: "q@{ q }" }
}

fn is_const(word) {
  if word == "true" || word == "false" || word == "null" || word == "nil" { return true }
  if word == "None" || word == "True" || word == "False" { return true }
  if word == "self" || word == "Self" || word == "this" || word == "super" { return true }
  return false
}

fn is_fn_kw(word) {
  if word == "fn" || word == "function" || word == "def" || word == "func" { return true }
  return false
}

fn types_of(which) {
  if which == "rust" { return "i32 u32 i64 u64 isize usize f32 f64 str bool char" }
  if which == "py" { return "int str list dict set tuple bool float bytes" }
  if which == "js" || which == "ts" { return "string number boolean any unknown never void object symbol bigint" }
  return ""
}

fn is_type(which, word) {
  if word.length == 0 { return false }
  let ch = word[0]
  if ch >= "A" && ch <= "Z" { return true }
  return listed(types_of(which), word)
}

fn skip_space(line, i) {
  while i < line.length && (line[i] == " " || line[i] == "\t") { let i = i + 1 }
  return i
}

fn call_next(line, i) {
  let j = skip_space(line, i)
  if j < line.length && line[j] == "(" { return true }
  return false
}

fn word_mark(which, word, line, i) {
  if which == "rust" && i < line.length && line[i] == "!" {
    if i + 1 >= line.length || line[i + 1] != "=" { return "m" }
  }
  if !is_kw(which, word) && !is_const(word) && call_next(line, i) { return "f" }
  if is_const(word) { return "o" }
  if is_kw(which, word) { return "k" }
  if is_type(which, word) { return "t" }
  return "."
}

fn take_word(parts, keep, line, i, which) {
  let start = i
  while i < line.length && is_ident(line[i]) { let i = i + 1 }
  let word = line.slice(start, i)
  let mark = word_mark(which, word, line, i)
  let end = i
  if mark == "m" { let end = i + 1 }
  let parts = fill(parts, keep, mark, start, end)
  let next = ""
  if mark == "k" && is_fn_kw(word) { let next = "F" }
  return { parts: parts, i: end, state: next }
}

fn take_fname(parts, keep, line, i) {
  let start = i
  while i < line.length && is_ident(line[i]) { let i = i + 1 }
  let parts = fill(parts, keep, "f", start, i)
  return { parts: parts, i: i }
}

fn take_var(parts, keep, line, i) {
  if i + 1 >= line.length { return { parts: push(parts, keep, "."), i: i + 1 } }
  let n = line[i + 1]
  if n == "(" { return { parts: push(parts, keep, "."), i: i + 1 } }
  if n == "{" {
    let parts = fill(parts, keep, "v", i, i + 2)
    let i = i + 2
    while i < line.length && is_ident(line[i]) {
      let parts = push(parts, keep, "v")
      let i = i + 1
    }
    if i < line.length && line[i] == "}" {
      let parts = push(parts, keep, "v")
      let i = i + 1
    }
    return { parts: parts, i: i }
  }
  if n == "?" || n == "#" || n == "@" || n == "*" || n == "$" || n == "!" || is_digit(n) {
    let parts = fill(parts, keep, "v", i, i + 2)
    let i = i + 2
    if is_digit(n) {
      while i < line.length && is_digit(line[i]) {
        let parts = push(parts, keep, "v")
        let i = i + 1
      }
    }
    return { parts: parts, i: i }
  }
  if is_ident(n) && !is_digit(n) {
    let parts = push(parts, keep, "v")
    let i = i + 1
    while i < line.length && is_ident(line[i]) {
      let parts = push(parts, keep, "v")
      let i = i + 1
    }
    return { parts: parts, i: i }
  }
  return { parts: push(parts, keep, "."), i: i + 1 }
}

fn take_deco(parts, keep, line, i) {
  let parts = push(parts, keep, "m")
  let i = i + 1
  while i < line.length && (line[i] == " " || line[i] == "\t") {
    let parts = push(parts, keep, ".")
    let i = i + 1
  }
  while i < line.length && (is_ident(line[i]) || line[i] == ".") {
    let parts = push(parts, keep, "m")
    let i = i + 1
  }
  return { parts: parts, i: i }
}

fn take_attr(parts, keep, line, i) {
  if i + 1 >= line.length || line[i + 1] != "[" { return null }
  let parts = fill(parts, keep, "m", i, i + 2)
  let i = i + 2
  while i < line.length && (line[i] == " " || line[i] == "\t") {
    let parts = push(parts, keep, ".")
    let i = i + 1
  }
  while i < line.length && is_ident(line[i]) {
    let parts = push(parts, keep, "m")
    let i = i + 1
  }
  return { parts: parts, i: i }
}

fn py_prefix(line, i) {
  let start = i
  while i < line.length && is_ident(line[i]) { let i = i + 1 }
  let word = line.slice(start, i)
  if !prefix_ok(word) { return null }
  if i >= line.length { return null }
  if line[i] != "\"" && line[i] != "'" { return null }
  return open_py(line, i, word.lower().contains("r"))
}

fn use_word(parts, keep, line, i, which, state) {
  let got = take_word(parts, keep, line, i, which)
  if got.state == "F" { let state = "F" }
  return { parts: got.parts, i: got.i, state: state }
}

fn rest_comment(parts, keep, line, i) {
  let parts = fill(parts, keep, "c", i, line.length)
  return parts
}

fn eat_long(parts, keep, line, i, state, mark) {
  let n = num_arg(state)
  let end = lua_end(line, i, n)
  if end >= 0 {
    let parts = fill(parts, keep, mark, i, end)
    return { parts: parts, i: end, state: "" }
  }
  let parts = push(parts, keep, mark)
  return { parts: parts, i: i + 1, state: state }
}

fn eat_raw(parts, keep, line, i, state) {
  let end = raw_end(line, i, num_arg(state))
  if end >= 0 {
    let parts = fill(parts, keep, "s", i, end)
    return { parts: parts, i: end, state: "" }
  }
  let parts = push(parts, keep, "s")
  return { parts: parts, i: i + 1, state: state }
}

fn eat_quote(parts, keep, line, i, state) {
  let kind = state[0]
  let q = state[1]
  if kind == "p" || kind == "u" {
    if line[i] == q && i + 2 < line.length && line[i + 1] == q && line[i + 2] == q {
      let parts = fill(parts, keep, "s", i, i + 3)
      return { parts: parts, i: i + 3, state: "" }
    }
    if kind == "p" && line[i] == "\\" && i + 1 < line.length {
      let parts = fill(parts, keep, "s", i, i + 2)
      return { parts: parts, i: i + 2, state: state }
    }
    let parts = push(parts, keep, "s")
    return { parts: parts, i: i + 1, state: state }
  }
  if kind == "a" {
    if line[i] == q {
      let parts = push(parts, keep, "s")
      return { parts: parts, i: i + 1, state: "" }
    }
    let parts = push(parts, keep, "s")
    return { parts: parts, i: i + 1, state: state }
  }
  if line[i] == "\\" && i + 1 < line.length {
    let parts = fill(parts, keep, "s", i, i + 2)
    return { parts: parts, i: i + 2, state: state }
  }
  if line[i] == q {
    let parts = push(parts, keep, "s")
    return { parts: parts, i: i + 1, state: "" }
  }
  let parts = push(parts, keep, "s")
  return { parts: parts, i: i + 1, state: state }
}

fn open_quote(line, i, which) {
  let ch = line[i]
  if which == "py" { return open_py(line, i, false) }
  if ch == "`" { return { at: i + 1, state: "q`" } }
  if ch == "'" && (which == "sh" || which == "btr") { return { at: i + 1, state: "a'" } }
  return { at: i + 1, state: "q@{ ch }" }
}

fn scan(line, which, state, keep) {
  let parts = []
  let i = 0
  if which == "" {
    let parts = fill(parts, keep, ".", 0, line.length)
    return { marks: parts.join(""), state: "" }
  }
  while i < line.length {
    let ch = line[i]
    if state == "F" {
      if ch == " " || ch == "\t" {
        let parts = push(parts, keep, ".")
        let i = i + 1
      } else if is_ident(ch) && !is_digit(ch) {
        let got = take_fname(parts, keep, line, i)
        let parts = got.parts
        let i = got.i
        let state = ""
      } else {
        let state = ""
      }
    } else if state == "c" {
      if ch == "*" && i + 1 < line.length && line[i + 1] == "/" {
        let parts = fill(parts, keep, "c", i, i + 2)
        let i = i + 2
        let state = ""
      } else {
        let parts = push(parts, keep, "c")
        let i = i + 1
      }
    } else if state.length > 0 && state[0] == "m" {
      let got = eat_long(parts, keep, line, i, state, "c")
      let parts = got.parts
      let i = got.i
      let state = got.state
    } else if state.length > 0 && state[0] == "l" {
      let got = eat_long(parts, keep, line, i, state, "s")
      let parts = got.parts
      let i = got.i
      let state = got.state
    } else if state.length > 0 && state[0] == "w" {
      let got = eat_raw(parts, keep, line, i, state)
      let parts = got.parts
      let i = got.i
      let state = got.state
    } else if state.length > 1 && (state[0] == "q" || state[0] == "a" || state[0] == "r" || state[0] == "p" || state[0] == "u") {
      let got = eat_quote(parts, keep, line, i, state)
      let parts = got.parts
      let i = got.i
      let state = got.state
    } else if (which == "btr" || which == "sh" || which == "py") && ch == "#" {
      let parts = rest_comment(parts, keep, line, i)
      let i = line.length
    } else if (which == "js" || which == "ts" || which == "rust") && ch == "/" && i + 1 < line.length && line[i + 1] == "/" {
      let parts = rest_comment(parts, keep, line, i)
      let i = line.length
    } else if (which == "js" || which == "ts" || which == "rust") && ch == "/" && i + 1 < line.length && line[i + 1] == "*" {
      let parts = fill(parts, keep, "c", i, i + 2)
      let i = i + 2
      let state = "c"
    } else if which == "lua" && ch == "-" && i + 1 < line.length && line[i + 1] == "-" {
      let got = lua_open(line, i + 2)
      if got == null {
        let parts = rest_comment(parts, keep, line, i)
        let i = line.length
      } else {
        let parts = fill(parts, keep, "c", i, got.at)
        let i = got.at
        let state = "m@{ got.n }"
      }
    } else if which == "lua" && ch == "[" {
      let got = lua_open(line, i)
      if got == null {
        let parts = push(parts, keep, ".")
        let i = i + 1
      } else {
        let parts = fill(parts, keep, "s", i, got.at)
        let i = got.at
        let state = "l@{ got.n }"
      }
    } else if which == "rust" && ch == "'" {
      if i + 1 < line.length && line[i + 1] == "\\" {
        let parts = push(parts, keep, "s")
        let i = i + 1
        let state = "q'"
      } else if i + 2 < line.length && line[i + 2] == "'" && line[i + 1] != "\\" {
        let parts = fill(parts, keep, "s", i, i + 3)
        let i = i + 3
      } else if i + 1 < line.length && is_ident(line[i + 1]) && !is_digit(line[i + 1]) {
        let parts = push(parts, keep, "k")
        let i = i + 1
        let start = i
        while i < line.length && is_ident(line[i]) { let i = i + 1 }
        let parts = fill(parts, keep, "k", start, i)
      } else {
        let parts = push(parts, keep, ".")
        let i = i + 1
      }
    } else if ch == "\"" || ch == "'" || (ch == "`" && (which == "js" || which == "ts")) {
      let got = open_quote(line, i, which)
      let parts = fill(parts, keep, "s", i, got.at)
      let i = got.at
      let state = got.state
    } else if is_digit(ch) || (ch == "." && i + 1 < line.length && line[i + 1] != "." && is_digit(line[i + 1])) {
      let end = take_num(line, i, which)
      let parts = fill(parts, keep, "n", i, end)
      let i = end
    } else if is_ident(ch) {
      if which == "rust" && (ch == "r" || ch == "b") {
        let got = rust_open(line, i)
        if got != null {
          let parts = fill(parts, keep, "s", i, got.at)
          let i = got.at
          let state = got.state
        } else {
          let gotw = use_word(parts, keep, line, i, which, state)
          let parts = gotw.parts
          let i = gotw.i
          let state = gotw.state
        }
      } else if which == "py" {
        let pre = py_prefix(line, i)
        if pre != null {
          let parts = fill(parts, keep, "s", i, pre.at)
          let i = pre.at
          let state = pre.state
        } else {
          let gotw = use_word(parts, keep, line, i, which, state)
          let parts = gotw.parts
          let i = gotw.i
          let state = gotw.state
        }
      } else {
        let gotw = use_word(parts, keep, line, i, which, state)
        let parts = gotw.parts
        let i = gotw.i
        let state = gotw.state
      }
    } else if which == "rust" && ch == "#" {
      let got = take_attr(parts, keep, line, i)
      if got == null {
        let parts = push(parts, keep, ".")
        let i = i + 1
      } else {
        let parts = got.parts
        let i = got.i
      }
    } else if (which == "py" || which == "ts") && ch == "@" {
      let got = take_deco(parts, keep, line, i)
      let parts = got.parts
      let i = got.i
    } else if which == "sh" && ch == "$" {
      let got = take_var(parts, keep, line, i)
      let parts = got.parts
      let i = got.i
    } else {
      let parts = push(parts, keep, ".")
      let i = i + 1
    }
  }
  if !keep { return { marks: "", state: state } }
  return { marks: parts.join(""), state: state }
}

# Returns the marks for lines[row], carrying an open string or block comment from above.
fn line_marks(lines, row, which) {
  if lines == null || row < 0 || row >= lines.length { return "" }
  let state = ""
  let i = 0
  while i < row {
    let state = scan(lines[i], which, state, false).state
    let i = i + 1
  }
  return scan(lines[row], which, state, true).marks
}
