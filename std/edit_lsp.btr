#!/usr/bin/env bettersh

# Connects a document to the language server named in the editor configuration.
# The whole document is sent when it changed since the last request or frame.
# A .btr file can have a second server for its shell text: the server line for sh. It sees
# the sh view from edit_shell, and its diagnostics join the file's own with an "sh:" prefix.
# Hover, completion, and Goto Definition ask it when the caret is in shell text.

import std/lsp
import std/path
import std/fs
import std/env
import std/theme
import std/edit_doc as doc
import std/edit_shell

let loaded = { note: "" }

# BETTERSH_EDITOR wins, even when it is empty. Otherwise the file is $HOME/.bettersh/editor.conf.
# Null means no file, or a file with a line that cannot be read. config_note says which.
fn read_config() {
  let junk = map_set(loaded, "note", "")
  let file = env.get("BETTERSH_EDITOR")
  if file == null {
    let home = env.get("HOME")
    if home == null { return null }
    let file = "@{ home }/.bettersh/editor.conf"
  }
  if file == "" { return null }
  let text = fs.load(file)
  if text == null { return null }
  let cfg = theme.load(text)
  if cfg == null { let junk = map_set(loaded, "note", "@{ file } has a line that cannot be read; using the defaults") }
  return cfg
}

# Why the last read_config returned null for a file that exists, or "".
fn config_note() {
  return loaded.note
}

fn server_cmd(cfg, ext) {
  if cfg == null || !cfg.has("servers") { return null }
  let list = cfg.servers
  let i = list.length
  while i > 0 {
    let i = i - 1
    if list[i].ext == ext { return list[i].cmd }
  }
  return null
}

fn body(d) {
  let text = d.lines.join("\n")
  if d.eol { return "@{ text }\n" }
  return text
}

fn up(session) {
  return session != null && session.ready && !session.dead
}

fn shell_up(d) {
  return d.has("shl") && up(d.shl)
}

fn pending(session) {
  return session != null && !session.ready && !session.dead && !session.shut && session.fail == ""
}

fn live(d) {
  return up(d.lsp) || shell_up(d)
}

# A server that has not answered initialize yet. Pumping it lets the answer arrive.
fn starting(d) {
  return pending(d.lsp) || (d.has("shl") && pending(d.shl))
}

# Why a server would not start, once: its answer to initialize, or "".
fn failure(d) {
  if d.lsp != null && !d.lsp.ready && d.lsp.fail != "" && !d.has("lsp_told") {
    let junk = map_set(d, "lsp_told", true)
    return "language server failed: @{ d.lsp.fail }"
  }
  if d.has("shl") && d.shl != null && !d.shl.ready && d.shl.fail != "" && !d.has("shl_told") {
    let junk = map_set(d, "shl_told", true)
    return "shell language server failed: @{ d.shl.fail }"
  }
  return ""
}

# The sh view of the document, kept until the next edit.
fn shell_view(d) {
  if d.has("shv") && d.shv != null && d.shv.version == d.version { return d.shv }
  let marks = []
  let r = 0
  while r < d.lines.length {
    let marks = marks.push(doc.marks(d, r))
    let r = r + 1
  }
  let got = edit_shell.view(d.lines, marks)
  let got = map_set(got, "version", d.version)
  let junk = map_set(d, "shv", got)
  return got
}

fn shell_text(d) {
  let text = shell_view(d).lines.join("\n")
  return "@{ text }\n"
}

# The shell server's diagnostics in the document's own columns. One that falls on an inserted
# value is dropped: the server only saw a stand-in there.
# A column of the sh view from UTF-16 units. Past the end of a trimmed line, a unit is a space.
fn view_col(vline, units) {
  let len = lsp.to_utf16(vline, vline.length)
  if units > len { return vline.length + units - len }
  return lsp.from_utf16(vline, units)
}

fn shell_diags(d) {
  if !d.has("shl") || d.shl == null || !d.shl.has("diags") { return [] }
  let v = shell_view(d)
  let out = []
  let list = d.shl.diags
  let i = 0
  while i < list.length {
    let g = list[i]
    let row = g.line
    if row >= 0 && row < d.lines.length && row < v.lines.length {
      let vline = v.lines[row]
      let a = view_col(vline, g.start)
      let b = view_col(vline, g.end)
      if !edit_shell.over_hole(v.holes, row, a, b) {
        let real = d.lines[row]
        let out = out.push({ line: row, start: lsp.to_utf16(real, a), end: lsp.to_utf16(real, b), message: "sh: @{ g.message }" })
      }
    }
    let i = i + 1
  }
  return out
}

fn merge_diags(d) {
  let mine = []
  if d.lsp != null && d.lsp.has("diags") { let mine = d.lsp.diags }
  if !d.has("shl") || d.shl == null || !d.shl.has("diags") {
    let junk = map_set(d, "diags", mine)
    return null
  }
  let ver = 0
  if d.has("shv") && d.shv != null { let ver = d.shv.version }
  if d.has("diag_from") && d.diag_from[0] == mine && d.diag_from[1] == d.shl.diags && d.diag_from[2] == ver { return null }
  let junk = map_set(d, "diag_from", [mine, d.shl.diags, ver])
  let out = []
  if d.lsp != null && d.lsp.has("diags") {
    let i = 0
    while i < d.lsp.diags.length {
      let out = out.push(d.lsp.diags[i])
      let i = i + 1
    }
  }
  let more = shell_diags(d)
  let i = 0
  while i < more.length {
    let out = out.push(more[i])
    let i = i + 1
  }
  let junk = map_set(d, "diags", out)
}

fn put_session(d, session) {
  let junk = map_set(d, "lsp", session)
  merge_diags(d)
}

fn put_shell(d, session) {
  let junk = map_set(d, "shl", session)
  merge_diags(d)
}

# The workspace for a file without a root line: the nearest folder above it that holds a
# project file such as Cargo.toml or package.json, or else the file's own folder.
fn project_root(p) {
  let start = path.dir(lsp.absolute(p, ""))
  let markers = ["Cargo.toml", "package.json", "tsconfig.json", "jsconfig.json", "pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", "go.mod", "compile_commands.json", ".git"]
  let dir = start
  let steps = 0
  while dir != "" && steps < 40 {
    let i = 0
    while i < markers.length {
      if fs.exists(path.join(dir, markers[i])) { return dir }
      let i = i + 1
    }
    if dir == "/" { return start }
    let up = path.dir(dir)
    if up == dir { return start }
    let dir = up
    let steps = steps + 1
  }
  return start
}

fn root_for(d, cfg) {
  let root = ""
  if cfg.has("root") { let root = cfg.root }
  if root == "" { let root = project_root(d.path) }
  return root
}

fn attach_main(d, cfg) {
  let cmd = server_cmd(cfg, path.ext(d.path))
  if cmd == null { return "" }
  let session = lsp.begin(cmd, d.path, body(d), root_for(d, cfg))
  if session == null { return "" }
  put_session(d, session)
  let junk = map_set(d, "lsp_ver", d.version)
  if session.dead { return "language server stopped" }
  let why = failure(d)
  if why != "" { return why }
  if !session.ready { return "language server starting" }
  return ""
}

# The shell text of a .btr file goes to the server for sh, as a file beside it named NAME.btr.sh.
fn attach_shell(d, cfg) {
  if d.lang != "btr" { return "" }
  let cmd = server_cmd(cfg, "sh")
  if cmd == null { return "" }
  let session = lsp.begin(cmd, "@{ d.path }.sh", shell_text(d), root_for(d, cfg))
  if session == null { return "" }
  put_shell(d, session)
  let junk = map_set(d, "shl_ver", d.version)
  if session.dead { return "shell language server stopped" }
  let why = failure(d)
  if why != "" { return why }
  if !session.ready { return "shell language server starting" }
  return ""
}

# Starts the servers for this file type. Returns a status message, or "".
fn attach(d, cfg) {
  if d.path == null { return "" }
  let note = attach_main(d, cfg)
  let more = attach_shell(d, cfg)
  if note == "" { return more }
  return note
}

# Sends the document when it changed.
fn sync(d) {
  if up(d.lsp) && d.lsp_ver != d.version {
    put_session(d, lsp.sync(d.lsp, body(d)))
    let junk = map_set(d, "lsp_ver", d.version)
  }
  if shell_up(d) && d.shl_ver != d.version {
    put_shell(d, lsp.sync(d.shl, shell_text(d)))
    let junk = map_set(d, "shl_ver", d.version)
  }
  return null
}

# Reads what the servers sent without waiting. True when the diagnostics changed.
fn pump(d) {
  let before = d.diags
  let woke = false
  if pending(d.lsp) {
    put_session(d, lsp.pump(d.lsp, 0, 1))
    if up(d.lsp) {
      let junk = map_set(d, "lsp_ver", 0)
      let woke = true
    }
  }
  if d.has("shl") && pending(d.shl) {
    put_shell(d, lsp.pump(d.shl, 0, 1))
    if up(d.shl) {
      let junk = map_set(d, "shl_ver", 0)
      let woke = true
    }
  }
  if !live(d) { return woke }
  sync(d)
  if up(d.lsp) { put_session(d, lsp.pump(d.lsp, 0, 1)) }
  if shell_up(d) { put_shell(d, lsp.pump(d.shl, 0, 1)) }
  return woke || d.diags != before
}

fn saved(d) {
  if !live(d) { return null }
  sync(d)
  if up(d.lsp) { put_session(d, lsp.saved(d.lsp)) }
  if shell_up(d) { put_shell(d, lsp.saved(d.shl)) }
  return null
}

# True when the primary caret is in shell text and the shell server can answer.
fn ask_shell(d) {
  if !shell_up(d) { return false }
  let s = doc.primary(d)
  return edit_shell.at(doc.marks(d, s.hr), s.hc)
}

# Hover text without Markdown code fences, which some servers send even when asked for plain text.
fn plain_hover(text) {
  let t = text.trim()
  if t.slice(0, 3) == "```" {
    let space = t.index(" ")
    if space > 0 { let t = t.slice(space + 1, t.length) }
    else { let t = t.slice(3, t.length) }
  }
  let t = t.replace("```", "")
  return t.trim()
}

fn hover(d) {
  if !live(d) { return "" }
  sync(d)
  let s = doc.primary(d)
  if ask_shell(d) {
    put_shell(d, lsp.hover(d.shl, shell_view(d).lines[s.hr], s.hr, s.hc))
    return plain_hover(d.shl.hover)
  }
  if !up(d.lsp) { return "" }
  put_session(d, lsp.hover(d.lsp, d.lines[s.hr], s.hr, s.hc))
  return plain_hover(d.lsp.hover)
}

# { path, row, col } for the definition under the primary caret, or null.
fn define(d) {
  if !live(d) { return null }
  sync(d)
  let s = doc.primary(d)
  if ask_shell(d) {
    put_shell(d, lsp.define(d.shl, shell_view(d).lines[s.hr], s.hr, s.hc))
    let session = d.shl
    if !session.jump_ok { return null }
    if session.jump_uri != session.uri { return { path: lsp.uri_path(session.jump_uri), row: session.jump_line, units: session.jump_col } }
    let row = session.jump_line
    if row < 0 || row >= d.lines.length { return null }
    let col = view_col(shell_view(d).lines[row], session.jump_col)
    return { path: d.path, row: row, units: lsp.to_utf16(d.lines[row], col) }
  }
  if !up(d.lsp) { return null }
  put_session(d, lsp.define(d.lsp, d.lines[s.hr], s.hr, s.hc))
  let session = d.lsp
  if !session.jump_ok { return null }
  let p = d.path
  if session.jump_uri != session.uri { let p = lsp.uri_path(session.jump_uri) }
  return { path: p, row: session.jump_line, units: session.jump_col }
}

fn item_name(item) {
  if kind(item) == "string" { return item }
  if kind(item) == "map" && item.has("name") { return item.name }
  return ""
}

# Completion items from the server: [{ name, blurb }].
fn complete(d) {
  if !live(d) { return [] }
  sync(d)
  let s = doc.primary(d)
  let items = []
  if ask_shell(d) {
    put_shell(d, lsp.complete(d.shl, shell_view(d).lines[s.hr], s.hr, s.hc))
    let items = d.shl.items
  } else if up(d.lsp) {
    put_session(d, lsp.complete(d.lsp, d.lines[s.hr], s.hr, s.hc))
    let items = d.lsp.items
  }
  let out = []
  let i = 0
  while i < items.length && out.length < 50 {
    let name = item_name(items[i])
    let blurb = ""
    if kind(items[i]) == "map" && items[i].has("blurb") { let blurb = items[i].blurb }
    if name != "" { let out = out.push({ name: name, blurb: blurb }) }
    let i = i + 1
  }
  return out
}

# The diagnostic message on row, or "".
fn message_at(d, row) {
  let list = d.diags
  let i = 0
  while i < list.length {
    if list[i].line == row { return list[i].message }
    let i = i + 1
  }
  return ""
}

fn stop(d) {
  if d.lsp != null {
    lsp.stop(d.lsp)
    let junk = map_set(d, "lsp", null)
  }
  if d.has("shl") && d.shl != null {
    lsp.stop(d.shl)
    let junk = map_set(d, "shl", null)
  }
  return null
}

fn units_to_col(line, units) {
  return lsp.from_utf16(line, units)
}
