#!/usr/bin/env bettersh

import std/strings

# Returns n, or 1 when n is below 1.
fn clamp_size(n) {
  if n < 1 { return 1 }
  return n
}

# Returns a screen of rows lines, each cols spaces. A size below 1 becomes 1.
fn blank(cols, rows) {
  let cols = clamp_size(cols)
  let rows = clamp_size(rows)
  let row = strings.repeat(" ", cols)
  let grid = []
  let i = 0
  while i < rows {
    let grid = grid.push(row)
    let i = i + 1
  }
  return { cols: cols, rows: rows, grid: grid }
}

# Writes text into row at col and clips it to the row. A column outside the row leaves the row unchanged.
fn splice(row, col, text) {
  if col < 0 || col >= row.length || text.length == 0 { return row }
  let room = row.length - col
  if text.length > room { let text = strings.slice(text, 0, room) }
  let end = col + text.length
  return "@{ strings.slice(row, 0, col) }@{ text }@{ strings.slice(row, end, row.length) }"
}

# Returns a copy of screen with text written at row, col. A row outside the screen is unchanged.
fn put(screen, row, col, text) {
  if row < 0 || row >= screen.rows { return screen }
  let grid = []
  let i = 0
  while i < screen.rows {
    let line = screen.grid[i]
    if i == row { let line = splice(line, col, text) }
    let grid = grid.push(line)
    let i = i + 1
  }
  return { cols: screen.cols, rows: screen.rows, grid: grid }
}

# Returns "+" followed by inner dashes and "+".
fn rule(inner) {
  return "+@{ strings.repeat("-", inner) }+"
}

# Returns a top rule with title. An empty title, or one that does not fit, is a plain rule.
fn top_rule(inner, title) {
  if title.length == 0 || title.length + 2 > inner { return rule(inner) }
  let dashes = inner - title.length - 2
  return "+ @{ title } @{ strings.repeat("-", dashes) }+"
}

# Draws a box of height h and width w on a copy of screen. A size below 2 leaves the screen unchanged.
fn box(screen, row, col, h, w, title) {
  if h < 2 || w < 2 { return screen }
  let inner = w - 2
  let screen = put(screen, row, col, top_rule(inner, title))
  let mid = "|@{ strings.repeat(" ", inner) }|"
  let i = 1
  while i < h - 1 {
    let screen = put(screen, row + i, col, mid)
    let i = i + 1
  }
  return put(screen, row + h - 1, col, rule(inner))
}

# Joins the screen rows with newlines.
fn paint(screen) {
  return screen.grid.join("\n")
}

# Returns one key event: key is the name, pending is an unfinished escape, and extra is a byte to feed again.
fn event(key, pending, extra) {
  return { key: key, pending: pending, extra: extra }
}

# Names one byte. Enter, backspace, tab, Ctrl-C, and Ctrl-S have names. Escape starts a pending sequence.
fn plain(byte) {
  let n = ord(byte)
  if n == 10 || n == 13 { return event("enter", "", null) }
  if n == 127 || n == 8 { return event("backspace", "", null) }
  if n == 9 { return event("tab", "", null) }
  if n == 3 { return event("ctrl-c", "", null) }
  if n == 19 { return event("ctrl-s", "", null) }
  if n == 27 { return event(null, byte, null) }
  if (n >= 32 && n <= 126) || n >= 128 { return event(byte, "", null) }
  return event(null, "", null)
}

# Names a finished escape sequence, or "" when it is not a known key.
fn named(seq) {
  let esc = chr(27)
  if seq == "@{ esc }[A" || seq == "@{ esc }OA" { return "up" }
  if seq == "@{ esc }[B" || seq == "@{ esc }OB" { return "down" }
  if seq == "@{ esc }[C" || seq == "@{ esc }OC" { return "right" }
  if seq == "@{ esc }[D" || seq == "@{ esc }OD" { return "left" }
  if seq == "@{ esc }[H" { return "home" }
  if seq == "@{ esc }[F" { return "end" }
  if seq == "@{ esc }[3~" { return "delete" }
  if seq == "@{ esc }[5~" { return "pageup" }
  if seq == "@{ esc }[6~" { return "pagedown" }
  return ""
}

# Feeds one byte into pending and returns the next event. A byte that is not one character leaves pending unchanged.
fn feed(pending, byte) {
  if byte == null || byte.length != 1 { return event(null, pending, null) }
  let esc = chr(27)
  if pending.length == 0 { return plain(byte) }
  if pending == esc && byte != "[" && byte != "O" {
    return event("escape", "", byte)
  }
  let seq = "@{ pending }@{ byte }"
  if seq == "@{ esc }[" || seq == "@{ esc }O" || seq == "@{ esc }[3" || seq == "@{ esc }[5" || seq == "@{ esc }[6" {
    return event(null, seq, null)
  }
  let key = named(seq)
  if key.length > 0 { return event(key, "", null) }
  return event(null, "", null)
}

# Turns a leftover escape into the escape key. Any other leftover is dropped.
fn flush(pending) {
  if pending == chr(27) { return event("escape", "", null) }
  return event(null, "", null)
}
