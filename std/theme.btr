#!/usr/bin/env bettersh

# Editor colors and the line-oriented editor.conf. A bad line makes load return null.
# Presets may store SGR parameter text. A user color is still a known name.

fn rgb(r, g, b) {
  return "38;2;@{ r };@{ g };@{ b }"
}

fn bold_rgb(r, g, b) {
  return "1;@{ rgb(r, g, b) }"
}

fn italic_rgb(r, g, b) {
  return "3;@{ rgb(r, g, b) }"
}

fn panel(fr, fg, fb, br, bg, bb) {
  return "@{ rgb(fr, fg, fb) };48;2;@{ br };@{ bg };@{ bb }"
}

fn paint(gutter, status, hint, comment, string, keyword, number, diag, text, function, type, constant, macro, variable) {
  return {
    gutter: gutter,
    status: status,
    hint: hint,
    comment: comment,
    string: string,
    keyword: keyword,
    number: number,
    diag: diag,
    text: text,
    function: function,
    type: type,
    constant: constant,
    macro: macro,
    variable: variable
  }
}

fn plain() {
  return paint("", "", "", "", "", "", "", "", "", "", "", "", "", "")
}

fn dark() {
  return paint("dim", "cyan", "dim", "dim", "green", "magenta", "yellow", "red", "", "cyan", "blue", "yellow", "red", "white")
}

fn light() {
  return paint(rgb(160, 161, 167), panel(56, 58, 66, 240, 240, 240), rgb(160, 161, 167), italic_rgb(160, 161, 167), rgb(80, 161, 79), rgb(166, 38, 164), rgb(152, 104, 1), rgb(228, 86, 73), rgb(56, 58, 66), rgb(64, 120, 242), rgb(193, 132, 1), rgb(152, 104, 1), rgb(228, 86, 73), rgb(1, 132, 188))
}

fn nord() {
  return paint(rgb(76, 86, 106), panel(236, 239, 244, 59, 66, 82), rgb(76, 86, 106), italic_rgb(76, 86, 106), rgb(163, 190, 140), rgb(129, 161, 193), rgb(235, 203, 139), rgb(191, 97, 106), rgb(216, 222, 233), rgb(136, 192, 208), rgb(143, 188, 187), rgb(180, 142, 173), rgb(208, 135, 112), rgb(94, 129, 172))
}

fn gruvbox() {
  return paint(rgb(146, 131, 116), panel(235, 219, 178, 60, 56, 54), rgb(168, 153, 132), italic_rgb(146, 131, 116), rgb(184, 187, 38), bold_rgb(251, 73, 52), rgb(211, 134, 155), rgb(251, 73, 52), rgb(235, 219, 178), rgb(250, 189, 47), rgb(142, 192, 124), rgb(254, 128, 25), rgb(214, 93, 14), rgb(131, 165, 152))
}

fn dracula() {
  return paint(rgb(98, 114, 164), panel(248, 248, 242, 68, 71, 90), rgb(98, 114, 164), italic_rgb(98, 114, 164), rgb(241, 250, 140), rgb(255, 121, 198), rgb(189, 147, 249), rgb(255, 85, 85), rgb(248, 248, 242), rgb(80, 250, 123), rgb(139, 233, 253), rgb(189, 147, 249), rgb(255, 184, 108), rgb(255, 184, 108))
}

fn catppuccin() {
  return paint(rgb(108, 112, 134), panel(205, 214, 244, 49, 50, 68), rgb(108, 112, 134), italic_rgb(108, 112, 134), rgb(166, 227, 161), rgb(203, 166, 247), rgb(250, 179, 135), rgb(243, 139, 168), rgb(205, 214, 244), rgb(137, 180, 250), rgb(249, 226, 175), rgb(243, 139, 168), rgb(235, 160, 172), rgb(137, 220, 235))
}

fn solarized() {
  return paint(rgb(88, 110, 117), panel(147, 161, 161, 7, 54, 66), rgb(88, 110, 117), italic_rgb(88, 110, 117), rgb(42, 161, 152), rgb(133, 153, 0), rgb(211, 54, 130), rgb(220, 50, 47), rgb(131, 148, 150), rgb(38, 139, 210), rgb(181, 137, 0), rgb(203, 75, 22), rgb(108, 113, 196), rgb(147, 161, 161))
}

fn monokai() {
  return paint(rgb(117, 113, 94), panel(248, 248, 242, 39, 40, 34), rgb(117, 113, 94), italic_rgb(117, 113, 94), rgb(230, 219, 116), bold_rgb(249, 38, 114), rgb(174, 129, 255), rgb(249, 38, 114), rgb(248, 248, 242), rgb(166, 226, 46), rgb(102, 217, 239), rgb(174, 129, 255), rgb(253, 151, 31), rgb(253, 151, 31))
}

fn tokyonight() {
  return paint(rgb(86, 95, 137), panel(192, 202, 245, 36, 40, 59), rgb(86, 95, 137), italic_rgb(86, 95, 137), rgb(158, 206, 106), rgb(187, 154, 247), rgb(255, 158, 100), rgb(247, 118, 142), rgb(192, 202, 245), rgb(122, 162, 247), rgb(42, 195, 222), rgb(224, 175, 104), bold_rgb(187, 154, 247), rgb(125, 207, 255))
}

fn known_role(name) {
  if name == "gutter" || name == "status" || name == "hint" || name == "comment" { return true }
  if name == "string" || name == "keyword" || name == "number" || name == "diag" || name == "text" { return true }
  if name == "function" || name == "type" || name == "constant" || name == "macro" || name == "variable" { return true }
  return name == "shell"
}

fn known_color(name) {
  if name == "black" || name == "red" || name == "green" || name == "yellow" { return true }
  if name == "blue" || name == "magenta" || name == "cyan" || name == "white" { return true }
  if name == "dim" || name == "bold" || name == "reverse" { return true }
  return false
}

fn sgr_code(style) {
  if style.length == 0 { return false }
  let i = 0
  while i < style.length {
    let ch = style[i]
    if ch != ";" && (ch < "0" || ch > "9") { return false }
    let i = i + 1
  }
  return true
}

fn sgr(style) {
  if style == "black" { return "30" }
  if style == "red" { return "31" }
  if style == "green" { return "32" }
  if style == "yellow" { return "33" }
  if style == "blue" { return "34" }
  if style == "magenta" { return "35" }
  if style == "cyan" { return "36" }
  if style == "white" { return "37" }
  if style == "dim" { return "2" }
  if style == "bold" { return "1" }
  if style == "reverse" { return "7" }
  if sgr_code(style) { return style }
  return ""
}

# Wraps text in the SGR for style. An empty style leaves text unchanged.
fn wrap(style, text) {
  if style == null || style == "" { return text }
  let code = sgr(style)
  if code == "" { return text }
  return "@{ chr(27) }[@{ code }m@{ text }@{ chr(27) }[0m"
}

# Returns true when any role has a color.
fn themed(theme) {
  if theme == null { return false }
  if theme.gutter != "" || theme.status != "" || theme.hint != "" || theme.comment != "" { return true }
  if theme.string != "" || theme.keyword != "" || theme.number != "" || theme.diag != "" || theme.text != "" { return true }
  if theme.function != "" || theme.type != "" || theme.constant != "" || theme.macro != "" || theme.variable != "" { return true }
  return false
}

fn field(line) {
  let at = line.index(" ")
  if at < 0 { return null }
  return { head: line.slice(0, at), rest: line.slice(at + 1, line.length).trim() }
}

fn preset(name) {
  if name == "dark" { return dark() }
  if name == "plain" { return plain() }
  if name == "light" { return light() }
  if name == "nord" { return nord() }
  if name == "gruvbox" { return gruvbox() }
  if name == "dracula" { return dracula() }
  if name == "catppuccin" || name == "mocha" { return catppuccin() }
  if name == "solarized" { return solarized() }
  if name == "monokai" { return monokai() }
  if name == "tokyonight" { return tokyonight() }
  return null
}

fn apply_theme(styles, rest) {
  let got = field(rest)
  if got == null { return null }
  if got.head == "name" { return preset(got.rest) }
  if !known_role(got.head) || !known_color(got.rest) { return null }
  return map_set(styles, got.head, got.rest)
}

# Editor settings and their kinds. A set line must name one of these.
fn setting_kind(name) {
  if name == "tab_size" { return "int" }
  if name == "translate_tabs_to_spaces" || name == "detect_indentation" || name == "auto_indent" { return "bool" }
  if name == "auto_match" || name == "auto_complete" || name == "highlight_line" || name == "line_numbers" { return "bool" }
  if name == "draw_indent_guides" || name == "menu_bar" || name == "mouse" || name == "scroll_past_end" { return "bool" }
  if name == "trim_trailing_white_space_on_save" || name == "ensure_newline_at_eof_on_save" { return "bool" }
  if name == "restore_session" || name == "word_wrap" || name == "minimap" { return "bool" }
  return ""
}

fn setting_value(kind, text) {
  if kind == "bool" {
    if text == "true" || text == "on" || text == "yes" { return true }
    if text == "false" || text == "off" || text == "no" { return false }
    return null
  }
  if kind == "int" {
    if text.length == 0 || text.length > 3 { return null }
    let n = 0
    let i = 0
    while i < text.length {
      let c = text[i]
      if c < "0" || c > "9" { return null }
      let n = n * 10 + "0123456789".index(c)
      let i = i + 1
    }
    if n < 1 || n > 16 { return null }
    return n
  }
  return null
}

# Reads editor.conf text. A theme line sets colors, server lines name commands, root sets the
# workspace, and set lines change editor settings such as "set tab_size 2".
fn load(text) {
  if text == null || kind(text) != "string" { return null }
  let styles = plain()
  let servers = []
  let root = ""
  let settings = {}
  let lines = text.replace("\t", " ").split("\n")
  let i = 0
  while i < lines.length {
    let line = lines[i].trim()
    let i = i + 1
    if line.length > 0 && line[0] != "#" {
      let got = field(line)
      if got == null { return null }
      if got.head == "theme" {
        let styles = apply_theme(styles, got.rest)
        if styles == null { return null }
      } else if got.head == "server" {
        let cmd = field(got.rest)
        if cmd == null || cmd.head.length == 0 || cmd.head.index(".") >= 0 || cmd.rest.length == 0 { return null }
        let servers = servers.push({ ext: cmd.head, cmd: cmd.rest })
      } else if got.head == "root" {
        if got.rest.length == 0 { return null }
        let root = got.rest
      } else if got.head == "set" {
        let pair = field(got.rest)
        if pair == null { return null }
        let k = setting_kind(pair.head)
        if k == "" { return null }
        let v = setting_value(k, pair.rest)
        if v == null { return null }
        let settings = map_set(settings, pair.head, v)
      } else {
        return null
      }
    }
  }
  let styles = map_set(styles, "servers", servers)
  let styles = map_set(styles, "settings", settings)
  return map_set(styles, "root", root)
}
