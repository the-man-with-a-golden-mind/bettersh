#!/usr/bin/env bettersh

# A terminal text editor that works like Sublime Text: no modes, multiple selections,
# Goto Anything, a command palette, find and replace, tabs, a side bar, and a run panel.
#
# The app state e holds the open documents (e.docs, e.at is the one shown), the clipboard,
# the theme, and whatever is open on top: e.overlay (palette, menu, dialog, hover), e.prompt
# (the bottom input row), e.bar (find or replace), and e.comp (the completion list).

import std/ui
import std/fs
import std/path
import std/strings
import std/theme
import std/codec
import std/env
import std/edit_text as tx
import std/edit_doc as doc
import std/edit_cmds as cmds
import std/edit_syntax
import std/edit_complete
import std/edit_lsp
import std/edit_files
import std/edit_run
import std/edit_view as view

let keys_hold = { map: null }

fn defaults() {
  return {
    tab_size: 4,
    translate_tabs_to_spaces: true,
    detect_indentation: true,
    auto_indent: true,
    auto_match: true,
    auto_complete: true,
    highlight_line: true,
    line_numbers: true,
    draw_indent_guides: true,
    menu_bar: true,
    mouse: true,
    scroll_past_end: true,
    trim_trailing_white_space_on_save: false,
    ensure_newline_at_eof_on_save: false,
    restore_session: true,
    word_wrap: false,
    minimap: false
  }
}

fn settings_of(cfg) {
  let out = defaults()
  if cfg == null || !cfg.has("settings") { return out }
  let keys = cfg.settings.keys()
  let i = 0
  while i < keys.length {
    let junk = map_set(out, keys[i], cfg.settings[keys[i]])
    let i = i + 1
  }
  return out
}

# Milliseconds from a fixed point, for double clicks.
fn now_ms() {
  return clock_ms()
}

fn cur(e) {
  return e.docs[e.at]
}

fn say(e, text) {
  let junk = map_set(e, "msg", text)
  let junk = map_set(e, "msg_bad", false)
}

fn warn(e, text) {
  let junk = map_set(e, "msg", text)
  let junk = map_set(e, "msg_bad", true)
}

fn doc_opts(e) {
  return { tab: e.settings.tab_size, spaces: e.settings.translate_tabs_to_spaces, detect: e.settings.detect_indentation, wrap: e.settings.word_wrap }
}

# Tab names. Two files with the same name also show their folder.
fn rename_tabs(e) {
  let names = []
  let i = 0
  while i < e.docs.length {
    let d = e.docs[i]
    let name = d.name
    if d.path == null && d.title != null { let name = d.title }
    let names = names.push(name)
    let i = i + 1
  }
  let shown = names.clone()
  let i = 0
  while i < e.docs.length {
    let d = e.docs[i]
    let k = 0
    let twin = false
    while k < e.docs.length {
      if k != i && names[k] == names[i] && d.path != null { let twin = true }
      let k = k + 1
    }
    if twin {
      let dir = path.base(path.dir(d.path))
      if dir != "" && dir != "." { let junk = shown.set(i, "@{ names[i] } — @{ dir }") }
    }
    let i = i + 1
  }
  let junk = map_set(e, "names", shown)
}

fn set_theme(e, colors) {
  let junk = map_set(e, "colors", colors)
  let junk = map_set(e, "pal", view.palette(colors))
  let junk = map_set(e, "screen", [])
}

# A blank buffer named untitled, untitled 2, and so on.
fn fresh_doc(e) {
  let d = doc.make(null, null, doc_opts(e))
  let junk = map_set(d, "eol", true)
  let n = 1
  let taken = true
  while taken {
    let name = "untitled"
    if n > 1 { let name = "untitled @{ n }" }
    let taken = false
    let i = 0
    while i < e.docs.length {
      if e.docs[i].path == null && e.docs[i].title == name { let taken = true }
      let i = i + 1
    }
    if !taken { let junk = map_set(d, "title", name) }
    let n = n + 1
  }
  return d
}

# The menus on the top row, as command ids.
fn menus() {
  return [
    { title: "File", items: ["new_file", "open_file", "reopen_closed", "save", "save_as", "save_all", "close_tab", "quit"] },
    { title: "Edit", items: ["undo", "redo", "cut", "copy", "paste", "duplicate", "delete_line", "join_lines", "swap_up", "swap_down", "toggle_comment", "indent", "unindent", "upper_case", "lower_case", "sort_lines"] },
    { title: "Selection", items: ["select_all", "select_line", "find_under_expand", "skip_occurrence", "select_all_occurrences", "split_lines", "add_caret_above", "add_caret_below", "expand_brackets", "single_selection"] },
    { title: "Find", items: ["find", "find_next", "find_prev", "replace", "find_in_files"] },
    { title: "View", items: ["toggle_sidebar", "toggle_panel", "toggle_word_wrap", "toggle_minimap", "fold", "unfold", "unfold_all", "toggle_line_numbers", "toggle_guides", "toggle_menu_bar"] },
    { title: "Goto", items: ["goto_anything", "goto_line", "goto_symbol", "goto_definition", "jump_back", "jump_bracket", "next_tab", "prev_tab"] },
    { title: "Tools", items: ["command_palette", "run_file", "open_repl", "open_shell", "complete", "show_hover", "trim_whitespace"] }
  ]
}

# An app of cols by rows with one empty buffer. cfg is a loaded editor.conf, or null.
fn make_app(cols, rows, cfg) {
  let colors = theme.nord()
  if cfg != null { let colors = cfg }
  let e = {
    cols: cols, rows: rows, docs: [], at: 0, names: [],
    cfg: cfg, settings: settings_of(cfg), colors: colors, pal: view.palette(colors),
    msg: "", msg_bad: false, chord: "",
    overlay: null, prompt: null, bar: null, comp: null,
    focus: "text", live: false, quit: false, quitting: false,
    clip: { pieces: [""], lines: false, text: "" }, clip_tool: null,
    find: { query: "", fold: true, whole: false },
    side: { open: false, root: ".", items: [], pick: 0, top: 0, opened: {} },
    files: [], files_at: 0 - 100000, closed: [], jumps: [],
    drag: null, click: { t: 0 - 100000, x: 0 - 1, y: 0 - 1, n: 0 },
    screen: [], menus: []
  }
  let junk = map_set(e, "menus", menus())
  let junk = e.docs.push(fresh_doc(e))
  rename_tabs(e)
  return e
}

# True for a buffer that was never touched, so opening a file can take its place.
fn pristine(d) {
  return d.path == null && !doc.dirty(d) && d.lines.length == 1 && d.lines[0] == "" && d.undo.length == 0
}

fn show(e, k) {
  if k < 0 || k >= e.docs.length { return null }
  let junk = map_set(e, "at", k)
  let junk = map_set(e, "comp", null)
  view.reveal(e)
}

# Adds d as a tab after the current one and shows it. A pristine current tab is replaced.
fn add_doc(e, d) {
  if e.docs.length == 1 && pristine(e.docs[0]) {
    let junk = e.docs.set(0, d)
    let junk = map_set(e, "at", 0)
  } else {
    let junk = e.docs.insert(e.at + 1, d)
    let junk = map_set(e, "at", e.at + 1)
  }
  rename_tabs(e)
  view.reveal(e)
}

fn find_doc(e, p) {
  let i = 0
  while i < e.docs.length {
    if e.docs[i].path != null && e.docs[i].path == p { return i }
    let i = i + 1
  }
  return 0 - 1
}

fn attach_lsp(e, d) {
  if e.cfg == null { return null }
  let note = edit_lsp.attach(d, e.cfg)
  if note != "" { warn(e, note) }
}

# Opens a file from the disk in a tab, or shows it when it is already open. False on an error.
fn open_path(e, p) {
  let k = find_doc(e, p)
  if k >= 0 {
    show(e, k)
    return true
  }
  let got = edit_files.read(p)
  if !got.ok {
    warn(e, "@{ got.err }: @{ p }")
    return false
  }
  let d = doc.make(got.text, p, doc_opts(e))
  if got.text == null { say(e, "New file: @{ p }") }
  add_doc(e, d)
  attach_lsp(e, d)
  return true
}

# Opens text as a tab named p. Nothing is read from the disk.
fn load(e, text, p) {
  let d = doc.make(text, p, doc_opts(e))
  add_doc(e, d)
  return d
}

fn new_file(e) {
  add_doc(e, fresh_doc(e))
}

# Remembers where the caret was before a jump, for Jump Back.
fn mark_jump(e) {
  let d = cur(e)
  let s = doc.primary(d)
  let junk = e.jumps.push({ d: d, r: s.hr, c: s.hc })
  if e.jumps.length > 100 { let junk = e.jumps.delete(0) }
}

# Scrolls so the primary caret is in the middle of the view.
fn center(e) {
  let d = cur(e)
  let lay = view.layout(e)
  let s = doc.primary(d)
  let junk = map_set(d, "top", view.clamp_top(e, s.hr - lay.view / 2))
  view.reveal(e)
}

fn goto_pos(e, r, c) {
  let d = cur(e)
  cmds.caret_at(d, r, c)
  center(e)
}

fn jump_back(e) {
  let going = true
  while going && e.jumps.length > 0 {
    let j = e.jumps.pop()
    let i = 0
    while i < e.docs.length {
      if e.docs[i] == j.d {
        show(e, i)
        goto_pos(e, j.r, j.c)
        return null
      }
      let i = i + 1
    }
  }
  say(e, "Nothing to jump back to")
}

# System clipboard: OSC 52 always, plus pbcopy, wl-copy, xclip, or xsel when one is installed.
fn clip_tool(e) {
  if e.clip_tool != null { return e.clip_tool }
  let found = capture("command -v pbcopy >/dev/null 2>&1 && echo mac || { command -v wl-copy >/dev/null 2>&1 && [ -n \"$WAYLAND_DISPLAY\" ] && echo wl; } || { command -v xclip >/dev/null 2>&1 && [ -n \"$DISPLAY\" ] && echo xclip; } || { command -v xsel >/dev/null 2>&1 && [ -n \"$DISPLAY\" ] && echo xsel; } || echo none").trim()
  let tool = { copy: "", paste: "" }
  if found == "mac" { let tool = { copy: "pbcopy", paste: "pbpaste" } }
  if found == "wl" { let tool = { copy: "wl-copy", paste: "wl-paste -n" } }
  if found == "xclip" { let tool = { copy: "xclip -selection clipboard", paste: "xclip -selection clipboard -o" } }
  if found == "xsel" { let tool = { copy: "xsel -b -i", paste: "xsel -b -o" } }
  let junk = map_set(e, "clip_tool", tool)
  return tool
}

fn scratch_file(name) {
  let dir = getenv("TMPDIR")
  if dir == null || dir == "" { let dir = "/tmp" }
  if dir[dir.length - 1] == "/" { return "@{ dir }@{ name }" }
  return "@{ dir }/@{ name }"
}

fn sys_copy(e, text) {
  if !e.live { return null }
  if text.length < 100000 { print("@{ chr(27) }]52;c;@{ codec.base64(text) }@{ chr(7) }") }
  let tool = clip_tool(e)
  if tool.copy == "" { return null }
  let file = scratch_file("bettersh-clip-@{ capture("printf %s $PPID") }")
  if fs.save(file, text) {
    let junk = capture("@{ tool.copy } < @{ edit_files.sh_quote(file) } >/dev/null 2>&1 || true")
    fs.remove(file)
  }
}

fn sys_paste(e) {
  if !e.live { return null }
  let tool = clip_tool(e)
  if tool.paste == "" { return null }
  return capture("@{ tool.paste } 2>/dev/null || true")
}

fn set_clip(e, got) {
  let text = got.pieces.join("")
  if !got.lines { let text = got.pieces.join("\n") }
  let junk = map_set(e, "clip", { pieces: got.pieces, lines: got.lines, text: text })
  sys_copy(e, text)
}

# The clipboard to paste. Text copied in another program wins over our own copy.
fn clip_now(e) {
  let outside = sys_paste(e)
  if outside != null && outside != "" && outside != e.clip.text {
    return { pieces: [outside], lines: false, text: outside }
  }
  return e.clip
}

fn prompt_refresh(e) {
  let p = e.prompt
  if p == null || p.kind != "path" { return null }
  let got = edit_files.choices(p.text)
  let junk = map_set(p, "shown", got.shown)
  let junk = map_set(p, "pick", 0)
}

# The bottom input row. act(e, text) runs on Enter. A path prompt lists completions.
fn ask_text(e, label, text, kind, act) {
  let p = { label: label, text: text, col: text.length, kind: kind, act: act, shown: [], pick: 0 }
  let junk = map_set(e, "prompt", p)
  prompt_refresh(e)
}

fn ask_path(e, label, text, act) {
  ask_text(e, label, text, "path", act)
}

fn ask(e, text, buttons, act) {
  let junk = map_set(e, "overlay", { kind: "confirm", text: text, buttons: buttons, pick: 0, act: act, at_r: 0, at_c: 0 })
}

# Writes d to its file. after(e) runs when the write worked.
fn write_doc(e, d, after) {
  if e.settings.trim_trailing_white_space_on_save { cmds.trim_trailing(d) }
  if e.settings.ensure_newline_at_eof_on_save { let junk = map_set(d, "eol", true) }
  let text = doc.file_text(d)
  if !fs.save(edit_files.write_target(d.path), text) {
    warn(e, "cannot write file: @{ d.path }")
    return false
  }
  doc.mark_saved(d)
  let junk = map_set(d, "disk", text)
  edit_lsp.saved(d)
  say(e, "Saved @{ d.path }")
  if after != null { after(e) }
  return true
}

# Gives d the file p and saves it there. An existing file other than its own asks first.
fn save_to(e, d, p, after) {
  if edit_files.is_dir(p) {
    warn(e, "is a directory: @{ p }")
    return null
  }
  let rename = fn(ee) {
    let junk = map_set(d, "path", p)
    let junk = map_set(d, "name", doc.base_name(p))
    let junk = map_set(d, "lang", edit_syntax.lang(p))
    doc.syn_reset(d)
    rename_tabs(ee)
    write_doc(ee, d, after)
    attach_lsp(ee, d)
  }
  if p != d.path && fs.exists(p) {
    ask(e, "@{ p } already exists. Replace it?", ["Replace", "Cancel"], fn(ee, choice) {
      if choice == 0 { rename(ee) }
    })
    return null
  }
  rename(e)
}

# Saves d, asking for a file name first when it has none.
fn save_doc(e, d, after) {
  if d.path != null { return write_doc(e, d, after) }
  ask_path(e, "Save As", "", fn(ee, text) {
    let list = edit_files.split_paths(text)
    if list.length > 0 { save_to(ee, d, list[0], after) }
  })
  return false
}

fn save_all(e) {
  let i = 0
  while i < e.docs.length {
    let d = e.docs[i]
    if doc.dirty(d) && d.path != null { save_doc(e, d, null) }
    let i = i + 1
  }
}

fn drop_tab(e, k) {
  let d = e.docs[k]
  edit_lsp.stop(d)
  if d.path != null {
    let junk = e.closed.push(d.path)
    if e.closed.length > 30 { let junk = e.closed.delete(0) }
  }
  let junk = e.docs.delete(k)
  if e.docs.length == 0 {
    let junk = map_set(e, "quit", true)
    let junk = e.docs.push(fresh_doc(e))
  }
  let at = e.at
  if at > k || at >= e.docs.length { let at = at - 1 }
  if at < 0 { let at = 0 }
  let junk = map_set(e, "at", at)
  rename_tabs(e)
  view.reveal(e)
}

fn index_of_doc(e, d) {
  let i = 0
  while i < e.docs.length {
    if e.docs[i] == d { return i }
    let i = i + 1
  }
  return 0 - 1
}

# Closes tab k. A dirty tab asks whether to save it first. Closing the last tab quits.
fn close_tab(e, k, after) {
  let d = e.docs[k]
  if !doc.dirty(d) {
    drop_tab(e, k)
    if after != null { after(e) }
    return null
  }
  show(e, k)
  let name = e.names[k]
  ask(e, "Save changes to @{ name } before closing?", ["Save", "Don't Save", "Cancel"], fn(ee, choice) {
    if choice == 0 {
      save_doc(ee, d, fn(e3) {
        let at = index_of_doc(e3, d)
        if at >= 0 { drop_tab(e3, at) }
        if after != null { after(e3) }
      })
    } else if choice == 1 {
      let at = index_of_doc(ee, d)
      if at >= 0 { drop_tab(ee, at) }
      if after != null { after(ee) }
    } else {
      let junk = map_set(ee, "quitting", false)
    }
  })
}

fn full_path(p) {
  if path.is_abs(p) { return p }
  let here = env.get("PWD")
  if here == null || here == "" { return p }
  if p == "." || p == "" { return here }
  return path.join(here, p)
}

# The open files, their carets and scroll, the active tab, and the side bar, one per line.
fn session_text(e) {
  let tab = chr(9)
  let lines = ["root@{ tab }@{ full_path(e.side.root) }@{ tab }@{ e.side.open }"]
  let active = 0
  let n = 0
  let i = 0
  while i < e.docs.length {
    let d = e.docs[i]
    if d.path != null && !d.has("results") {
      if i == e.at { let active = n }
      let s = doc.primary(d)
      let lines = lines.push("file@{ tab }@{ full_path(d.path) }@{ tab }@{ s.hr }@{ tab }@{ s.hc }@{ tab }@{ d.top }")
      let n = n + 1
    }
    let i = i + 1
  }
  let lines = lines.push("active@{ tab }@{ active }")
  return "@{ lines.join("\n") }\n"
}

# Writes the session. A file that cannot be written is skipped.
fn save_session(e, file) {
  if file == "" { return false }
  let dir = path.dir(file)
  if dir != "" && !fs.exists(dir) { fs.mkdir(dir) }
  return fs.save(file, session_text(e))
}

# BETTERSH_SESSION names the session file. Otherwise it is $HOME/.bettersh/session.
fn session_path() {
  let file = env.get("BETTERSH_SESSION")
  if file != null { return file }
  let home = env.get("HOME")
  if home == null { return "" }
  return "@{ home }/.bettersh/session"
}

# Quits after asking about each dirty tab in turn.
fn quit(e) {
  if !e.quitting && e.live && e.settings.restore_session { save_session(e, session_path()) }
  let junk = map_set(e, "quitting", true)
  let i = 0
  while i < e.docs.length {
    if doc.dirty(e.docs[i]) {
      close_tab(e, i, fn(ee) {
        if ee.quitting { quit(ee) }
      })
      return null
    }
    let i = i + 1
  }
  let junk = map_set(e, "quit", true)
}

fn reopen_closed(e) {
  if e.closed.length == 0 {
    say(e, "No closed tabs to reopen")
    return null
  }
  open_path(e, e.closed.pop())
}

# Reloads files that changed on the disk. A dirty buffer only gets a warning.
fn check_disk(e) {
  let i = 0
  while i < e.docs.length {
    let d = e.docs[i]
    if d.path != null && d.disk != null {
      let now = fs.load(d.path)
      if now != null && now != d.disk {
        if doc.dirty(d) {
          warn(e, "@{ e.names[i] } changed on disk; save to overwrite it, or close it and open it again")
        } else {
          let got = doc.split_text(now)
          let last = d.lines.length - 1
          doc.begin(d, "reload")
          let junk = doc.replace(d, 0, 0, last, d.lines[last].length, got.lines.join("\n"))
          let junk = map_set(d, "eol", got.eol)
          let junk = map_set(d, "crlf", got.crlf)
          doc.set_sels(d, d.sels)
          doc.commit(d)
          doc.mark_saved(d)
          say(e, "Reloaded @{ e.names[i] }")
        }
        let junk = map_set(d, "disk", now)
      }
    }
    let i = i + 1
  }
}

# Edits a one-line field { text, col, all } for one key. all means the whole text is selected,
# so the next edit replaces it. False when the key is not an edit.
fn field_key(f, key, ev) {
  let t = f.text
  let c = f.col
  if c > t.length { let c = t.length }
  let all = f.has("all") && f.all
  if key == "ctrl-a" {
    let junk = map_set(f, "all", t != "")
    let junk = map_set(f, "col", t.length)
    return true
  }
  let typing = key == "paste" || key == "text" || (key.length == 1 && ord(key) >= 32)
  let erasing = key == "backspace" || key == "delete" || key == "ctrl-backspace" || key == "alt-backspace" || key == "ctrl-w"
  if all && (typing || erasing) {
    let t = ""
    let c = 0
    if erasing {
      let junk = map_set(f, "text", "")
      let junk = map_set(f, "col", 0)
      let junk = map_set(f, "all", false)
      return true
    }
  }
  let nt = t
  let nc = c
  if key == "left" { if c > 0 && !all { let nc = c - 1 } }
  else if key == "right" { if c < t.length && !all { let nc = c + 1 } }
  else if key == "home" { let nc = 0 }
  else if key == "end" || key == "ctrl-e" { let nc = t.length }
  else if key == "ctrl-left" || key == "alt-b" { let nc = tx.word_left(t, c) }
  else if key == "ctrl-right" || key == "alt-f" { let nc = tx.word_right(t, c) }
  else if key == "backspace" {
    if c > 0 {
      let nt = "@{ t.slice(0, c - 1) }@{ t.slice(c, t.length) }"
      let nc = c - 1
    }
  } else if key == "delete" {
    if c < t.length { let nt = "@{ t.slice(0, c) }@{ t.slice(c + 1, t.length) }" }
  } else if key == "ctrl-backspace" || key == "alt-backspace" || key == "ctrl-w" {
    let a = tx.word_left(t, c)
    let nt = "@{ t.slice(0, a) }@{ t.slice(c, t.length) }"
    let nc = a
  } else if key == "ctrl-u" {
    let nt = t.slice(c, t.length)
    let nc = 0
  } else if key == "ctrl-k" {
    let nt = t.slice(0, c)
  } else if key == "paste" || key == "text" {
    let add = ev.text.replace("\n", " ")
    let nt = "@{ t.slice(0, c) }@{ add }@{ t.slice(c, t.length) }"
    let nc = c + add.length
  } else if key.length == 1 && ord(key) >= 32 {
    let nt = "@{ t.slice(0, c) }@{ key }@{ t.slice(c, t.length) }"
    let nc = c + 1
  } else {
    return false
  }
  let junk = map_set(f, "text", nt)
  let junk = map_set(f, "col", nc)
  let junk = map_set(f, "all", false)
  return true
}

fn bar_count(e) {
  let b = e.bar
  let d = cur(e)
  let junk = map_set(b, "ver", d.version)
  let junk = map_set(b, "count", cmds.count_matches(d, b.query, b.fold, b.whole))
  let s = doc.primary(d)
  let at = 0
  if b.query != "" && cmds.on_match(d, b.query, b.fold) {
    let a = doc.lo(s)
    let at = cmds.match_index(d, b.query, b.fold, b.whole, a.r, a.c)
  }
  let junk = map_set(b, "at", at)
}

fn bar_open(e, kind) {
  let d = cur(e)
  let s = doc.primary(d)
  let q = e.find.query
  if !doc.empty(s) && s.ar == s.hr { let q = doc.sel_text(d, s) }
  let b = { kind: kind, query: q, qcol: q.length, repl: "", rcol: 0, field: 0, fold: e.find.fold, whole: e.find.whole, count: 0 - 1, at: 0, origin: doc.copy_sels(d.sels), top: d.top, focus: true, qall: q != "", rall: false, ver: 0 }
  if e.bar != null && e.bar.kind != kind {
    let junk = map_set(b, "repl", e.bar.repl)
    let junk = map_set(b, "rcol", e.bar.repl.length)
  }
  if kind == "replace" && q != "" { let junk = map_set(b, "field", 1) }
  let junk = map_set(e, "bar", b)
  let junk = map_set(e, "comp", null)
  bar_count(e)
}

fn remember_find(e) {
  let b = e.bar
  if b == null { return null }
  let junk = map_set(e, "find", { query: b.query, fold: b.fold, whole: b.whole })
}

# Selects the next match after the selection (or before it, when back). False when there is none.
fn find_step(e, back) {
  let d = cur(e)
  let f = e.find
  if e.bar != null { let f = e.bar }
  if f.query == "" { return false }
  let s = doc.primary(d)
  let at = null
  if back {
    let a = doc.lo(s)
    let at = cmds.search_backward(d, f.query, a.r, a.c, f.fold, f.whole)
  } else {
    let b = doc.hi(s)
    let at = cmds.search_forward(d, f.query, b.r, b.c, f.fold, f.whole)
  }
  if at == null {
    warn(e, "Unable to find @{ f.query }")
    return false
  }
  doc.single(d, cmds.span_for(d, at, f.query))
  doc.seal(d)
  view.reveal(e)
  if e.bar != null { bar_count(e) }
  return true
}

# Typing in the find field moves to the first match from where the search started.
fn find_live(e) {
  let b = e.bar
  let d = cur(e)
  doc.set_sels(d, doc.copy_sels(b.origin))
  let junk = map_set(d, "top", b.top)
  if b.query == "" {
    bar_count(e)
    return null
  }
  let a = doc.lo(doc.primary(d))
  let at = cmds.search_forward(d, b.query, a.r, a.c, b.fold, b.whole)
  if at != null {
    doc.single(d, cmds.span_for(d, at, b.query))
    view.reveal(e)
  }
  bar_count(e)
}

fn replace_next(e) {
  let b = e.bar
  let d = cur(e)
  if b.query == "" { return null }
  if cmds.on_match(d, b.query, b.fold) {
    doc.insert(d, "replace", b.repl)
    doc.seal(d)
  }
  find_step(e, false)
}

fn replace_every(e) {
  let b = e.bar
  let d = cur(e)
  let n = cmds.replace_all(d, b.query, b.repl, b.fold, b.whole)
  view.reveal(e)
  bar_count(e)
  if n == 0 { warn(e, "Unable to find @{ b.query }") }
  else if n == 1 { say(e, "Replaced 1 occurrence") }
  else { say(e, "Replaced @{ n } occurrences") }
}

fn bar_key(e, key, ev) {
  let b = e.bar
  if key == "escape" {
    remember_find(e)
    let junk = map_set(e, "bar", null)
    return null
  }
  if key == "alt-c" {
    let junk = map_set(b, "fold", !b.fold)
    find_live(e)
    return null
  }
  if key == "alt-w" {
    let junk = map_set(b, "whole", !b.whole)
    find_live(e)
    return null
  }
  if key == "tab" || key == "shift-tab" || key == "up" || key == "down" {
    if b.kind == "replace" {
      let junk = map_set(b, "field", 1 - b.field)
      let junk = map_set(b, "qall", b.field == 0 && b.query != "")
      let junk = map_set(b, "rall", b.field == 1 && b.repl != "")
    }
    return null
  }
  if key == "enter" || key == "f3" {
    remember_find(e)
    if b.kind == "replace" && b.field == 1 { replace_next(e) }
    else { find_step(e, false) }
    let junk = map_set(b, "origin", doc.copy_sels(cur(e).sels))
    return null
  }
  if key == "shift-enter" || key == "shift-f3" {
    remember_find(e)
    find_step(e, true)
    let junk = map_set(b, "origin", doc.copy_sels(cur(e).sels))
    return null
  }
  if key == "alt-enter" || key == "ctrl-alt-enter" {
    remember_find(e)
    if b.kind == "replace" {
      replace_every(e)
      return null
    }
    let n = cmds.select_matches(cur(e), b.query, b.fold, b.whole)
    if n == 0 { warn(e, "Unable to find @{ b.query }") }
    let junk = map_set(e, "bar", null)
    view.reveal(e)
    return null
  }
  let f = { text: b.query, col: b.qcol, all: b.qall }
  if b.field == 1 { let f = { text: b.repl, col: b.rcol, all: b.rall } }
  if !field_key(f, key, ev) { return "pass" }
  if b.field == 1 {
    let junk = map_set(b, "repl", f.text)
    let junk = map_set(b, "rcol", f.col)
    let junk = map_set(b, "rall", f.all)
    return null
  }
  let junk = map_set(b, "qall", f.all)
  let changed = f.text != b.query
  let junk = map_set(b, "query", f.text)
  let junk = map_set(b, "qcol", f.col)
  if changed { find_live(e) }
  return null
}

fn file_list(e) {
  let t = now_ms()
  if t - e.files_at > 10000 || e.files.length == 0 {
    let junk = map_set(e, "files", edit_files.project_files(e.side.root, 20000))
    let junk = map_set(e, "files_at", t)
  }
  return e.files
}

