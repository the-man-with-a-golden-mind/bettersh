#!/usr/bin/env bettersh

# JSON text. parse returns null on bad input. stringify returns null for a function or a value deeper than 32.

fn ws(ch) {
  if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" { return true }
  return false
}

fn skip_ws(text, i) {
  while i < text.length && ws(text[i]) { let i = i + 1 }
  return i
}

fn hex_val(ch) {
  if ch >= "0" && ch <= "9" { return ord(ch) - 48 }
  if ch >= "a" && ch <= "f" { return ord(ch) - 87 }
  if ch >= "A" && ch <= "F" { return ord(ch) - 55 }
  return 0 - 1
}

fn wordish(ch) {
  if ch >= "a" && ch <= "z" { return true }
  if ch >= "A" && ch <= "Z" { return true }
  if ch >= "0" && ch <= "9" { return true }
  if ch == "_" { return true }
  return false
}

fn literal(text, i, word, value) {
  let n = word.length
  if i + n > text.length { return null }
  if text.slice(i, i + n) != word { return null }
  if i + n < text.length && wordish(text[i + n]) { return null }
  return { value: value, at: i + n }
}

fn u4(text, i) {
  if i + 4 > text.length { return null }
  let n = 0
  let k = 0
  while k < 4 {
    let d = hex_val(text[i + k])
    if d < 0 { return null }
    let n = n * 16 + d
    let k = k + 1
  }
  return { n: n, at: i + 4 }
}

fn parse_string(text, i) {
  if i >= text.length || text[i] != "\"" { return null }
  let parts = []
  let i = i + 1
  while i < text.length {
    let ch = text[i]
    let n = ord(ch)
    if n < 32 { return null }
    if ch == "\"" { return { value: parts.join(""), at: i + 1 } }
    if ch == "\\" {
      if i + 1 >= text.length { return null }
      let e = text[i + 1]
      if e == "\"" || e == "\\" || e == "/" {
        let parts = parts.push(e)
        let i = i + 2
      } else if e == "b" {
        let parts = parts.push(chr(8))
        let i = i + 2
      } else if e == "f" {
        let parts = parts.push(chr(12))
        let i = i + 2
      } else if e == "n" {
        let parts = parts.push("\n")
        let i = i + 2
      } else if e == "r" {
        let parts = parts.push("\r")
        let i = i + 2
      } else if e == "t" {
        let parts = parts.push("\t")
        let i = i + 2
      } else if e == "u" {
        let h = u4(text, i + 2)
        if h == null { return null }
        if h.n >= 55296 && h.n <= 56319 {
          if h.at + 1 >= text.length || text[h.at] != "\\" || text[h.at + 1] != "u" { return null }
          let lo = u4(text, h.at + 2)
          if lo == null || lo.n < 56320 || lo.n > 57343 { return null }
          let cp = (h.n - 55296) * 1024 + (lo.n - 56320) + 65536
          let parts = parts.push(chr(cp))
          let i = lo.at
        } else if h.n >= 56320 && h.n <= 57343 {
          return null
        } else {
          let parts = parts.push(chr(h.n))
          let i = h.at
        }
      } else {
        return null
      }
    } else {
      let parts = parts.push(ch)
      let i = i + 1
    }
  }
  return null
}

fn scan_number(text, i) {
  let start = i
  if i < text.length && text[i] == "-" { let i = i + 1 }
  if i >= text.length { return null }
  let ch = text[i]
  if ch < "0" || ch > "9" { return null }
  if ch == "0" {
    let i = i + 1
    if i < text.length && text[i] >= "0" && text[i] <= "9" { return null }
  } else {
    while i < text.length && text[i] >= "0" && text[i] <= "9" { let i = i + 1 }
  }
  let dotted = false
  let expo = false
  if i < text.length && text[i] == "." {
    let dotted = true
    let i = i + 1
    let frac = i
    while i < text.length && text[i] >= "0" && text[i] <= "9" { let i = i + 1 }
    if i == frac { return null }
  }
  if i < text.length && (text[i] == "e" || text[i] == "E") {
    let expo = true
    let i = i + 1
    if i < text.length && (text[i] == "+" || text[i] == "-") { let i = i + 1 }
    let ed = i
    while i < text.length && text[i] >= "0" && text[i] <= "9" { let i = i + 1 }
    if i == ed { return null }
  }
  return { start: start, at: i, dotted: dotted, expo: expo }
}

fn int_value(text) {
  let i = 0
  let neg = false
  if text[0] == "-" {
    let neg = true
    let i = 1
  }
  let acc = 0
  let lim = 922337203685477580
  while i < text.length {
    let d = ord(text[i]) - 48
    if acc < lim {
      let acc = acc * 10 + d
    } else if acc == lim && neg && d < 8 {
      let acc = acc * 10 + d
    } else if acc == lim && neg && d == 8 && i + 1 == text.length {
      return { ok: true, n: 0 - 9223372036854775807 - 1 }
    } else if acc == lim && !neg && d <= 7 {
      let acc = acc * 10 + d
    } else {
      return { ok: false, n: 0 }
    }
    let i = i + 1
  }
  if neg { return { ok: true, n: 0 - acc } }
  return { ok: true, n: acc }
}

fn float_value(text) {
  let i = 0
  let neg = false
  if text[0] == "-" {
    let neg = true
    let i = 1
  }
  let acc = 0.0
  let n = 0
  while i < text.length && text[i] >= "0" && text[i] <= "9" {
    if n >= 400 { return null }
    let acc = acc * 10.0 + (ord(text[i]) - 48)
    let n = n + 1
    let i = i + 1
  }
  if i < text.length && text[i] == "." {
    let i = i + 1
    let place = 0.1
    while i < text.length && text[i] >= "0" && text[i] <= "9" {
      if n >= 400 { return null }
      let acc = acc + (ord(text[i]) - 48) * place
      let place = place / 10.0
      let n = n + 1
      let i = i + 1
    }
  }
  if i < text.length && (text[i] == "e" || text[i] == "E") {
    let i = i + 1
    let eneg = false
    if i < text.length && text[i] == "+" { let i = i + 1 }
    else if i < text.length && text[i] == "-" {
      let eneg = true
      let i = i + 1
    }
    let exp = 0
    while i < text.length && text[i] >= "0" && text[i] <= "9" {
      let exp = exp * 10 + (ord(text[i]) - 48)
      if exp > 308 { return null }
      let i = i + 1
    }
    let k = 0
    while k < exp {
      if eneg { let acc = acc / 10.0 }
      else { let acc = acc * 10.0 }
      let k = k + 1
    }
  }
  if neg { return 0.0 - acc }
  return acc
}

fn parse_number(text, i) {
  let span = scan_number(text, i)
  if span == null { return null }
  let slice = text.slice(span.start, span.at)
  if !span.dotted && !span.expo {
    let as_int = int_value(slice)
    if as_int.ok { return { value: as_int.n, at: span.at } }
  }
  let num = float_value(slice)
  if num == null { return null }
  return { value: num, at: span.at }
}

fn parse_at(text, i, depth) {
  if depth > 32 { return null }
  let i = skip_ws(text, i)
  if i >= text.length { return null }
  let ch = text[i]
  if ch == "n" { return literal(text, i, "null", null) }
  if ch == "t" { return literal(text, i, "true", true) }
  if ch == "f" { return literal(text, i, "false", false) }
  if ch == "\"" { return parse_string(text, i) }
  if ch == "-" || (ch >= "0" && ch <= "9") { return parse_number(text, i) }
  if ch == "[" {
    let i = i + 1
    let i = skip_ws(text, i)
    let arr = []
    if i < text.length && text[i] == "]" { return { value: arr, at: i + 1 } }
    let going = true
    while going {
      let item = parse_at(text, i, depth + 1)
      if item == null { return null }
      let arr = arr.push(item.value)
      let i = skip_ws(text, item.at)
      if i < text.length && text[i] == "," { let i = skip_ws(text, i + 1) }
      else { let going = false }
    }
    if i >= text.length || text[i] != "]" { return null }
    return { value: arr, at: i + 1 }
  }
  if ch == "{" {
    let i = i + 1
    let i = skip_ws(text, i)
    let obj = {}
    if i < text.length && text[i] == "}" { return { value: obj, at: i + 1 } }
    let going = true
    while going {
      if i >= text.length || text[i] != "\"" { return null }
      let key = parse_string(text, i)
      if key == null || key.value.index(chr(0)) >= 0 { return null }
      let i = skip_ws(text, key.at)
      if i >= text.length || text[i] != ":" { return null }
      let item = parse_at(text, i + 1, depth + 1)
      if item == null { return null }
      let obj = map_set(obj, key.value, item.value)
      let i = skip_ws(text, item.at)
      if i < text.length && text[i] == "," { let i = skip_ws(text, i + 1) }
      else { let going = false }
    }
    if i >= text.length || text[i] != "}" { return null }
    return { value: obj, at: i + 1 }
  }
  return null
}

# Returns the one JSON value in text, or null when the text is not JSON.
fn parse(text) {
  if text == null || kind(text) != "string" { return null }
  let got = parse_at(text, 0, 0)
  if got == null { return null }
  if skip_ws(text, got.at) != text.length { return null }
  return got.value
}

fn hex2(n) {
  let digits = "0123456789abcdef"
  return "@{ digits[n / 16] }@{ digits[n % 16] }"
}

fn quote(text) {
  let parts = ["\""]
  let i = 0
  while i < text.length {
    let ch = text[i]
    let n = ord(ch)
    if ch == "\"" || ch == "\\" {
      let parts = parts.push("\\")
      let parts = parts.push(ch)
    } else if ch == "\n" {
      let parts = parts.push("\\n")
    } else if ch == "\r" {
      let parts = parts.push("\\r")
    } else if ch == "\t" {
      let parts = parts.push("\\t")
    } else if n == 8 {
      let parts = parts.push("\\b")
    } else if n == 12 {
      let parts = parts.push("\\f")
    } else if n < 32 {
      let parts = parts.push("\\u00")
      let parts = parts.push(hex2(n))
    } else {
      let parts = parts.push(ch)
    }
    let i = i + 1
  }
  let parts = parts.push("\"")
  return parts.join("")
}

fn shown(value) {
  let text = "x@{ value }"
  return text.slice(1, text.length)
}

fn bad_float(text) {
  let i = 0
  while i < text.length {
    let ch = text[i]
    if ch != "e" && ch != "E" && ((ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z")) { return true }
    let i = i + 1
  }
  return false
}

fn dump(value, depth) {
  if depth > 32 { return null }
  let k = kind(value)
  if k == "null" { return "null" }
  if k == "bool" {
    if value { return "true" }
    return "false"
  }
  if k == "int" { return shown(value) }
  if k == "float" {
    let text = shown(value)
    if bad_float(text) { return null }
    return text
  }
  if k == "string" { return quote(value) }
  if k == "fn" { return null }
  if k == "array" {
    let parts = []
    let i = 0
    while i < value.length {
      let part = dump(value[i], depth + 1)
      if part == null { return null }
      let parts = parts.push(part)
      let i = i + 1
    }
    return "[@{ parts.join(",") }]"
  }
  if k == "map" {
    let keys = value.keys()
    let parts = []
    let i = 0
    while i < keys.length {
      let key = keys[i]
      if kind(key) != "string" { return null }
      let part = dump(value[key], depth + 1)
      if part == null { return null }
      let parts = parts.push("@{ quote(key) }:@{ part }")
      let i = i + 1
    }
    return "{@{ parts.join(",") }}"
  }
  return null
}

# Returns JSON text for value, or null when value cannot be encoded.
fn stringify(value) {
  return dump(value, 0)
}
