#!/usr/bin/env bettersh

# Prompt for the btr terminal shell. Stdout is a header, then ASCII RS (byte 30),
# then the prompt text. Header lines are K/S/C/T/N/D plus an SGR parameter list,
# and X/U/M set syntax, suggestions, and tab completion to 1 or 0.
# The file is data, not a script: theme, segment, and plugin lines in
# ~/.bettersh/btr.conf. A segment that is not built in is ~/.bettersh/btr/<name>.btr.

import std/theme
import std/fs
import std/io
import std/strings

fn parse_int(text) {
  let n = 0
  let i = 0
  let any = false
  if text == null || text == "" { return 0 }
  while i < text.length {
    let ch = text[i]
    if ch < "0" || ch > "9" {
      if any { return n }
      return 0
    }
    let n = n * 10 + (ord(ch) - 48)
    let any = true
    let i = i + 1
  }
  return n
}

fn second_num(text) {
  let i = 0
  while i < text.length {
    let ch = text[i]
    if ch == " " || ch == "\t" {
      return parse_int(text.slice(i + 1, text.length).trim())
    }
    let i = i + 1
  }
  return 0
}

fn quote(text) {
  let out = "'"
  let i = 0
  if text == null { return "''" }
  while i < text.length {
    let ch = text[i]
    if ch == "'" { let out = "@{ out }'\"'\"'" }
    else { let out = "@{ out }@{ ch }" }
    let i = i + 1
  }
  return "@{ out }'"
}

fn safe_name(name) {
  let i = 0
  if name == null || name.length == 0 || name.length > 32 { return false }
  while i < name.length {
    let ch = name[i]
    let ok = false
    if ch >= "a" && ch <= "z" { let ok = true }
    if ch >= "A" && ch <= "Z" { let ok = true }
    if ch >= "0" && ch <= "9" { let ok = true }
    if ch == "_" || ch == "-" { let ok = true }
    if !ok { return false }
    let i = i + 1
  }
  return true
}

# Replaces terminal controls so a directory or branch cannot retitle the terminal.
fn plain_text(text) {
  let out = ""
  let i = 0
  if text == null { return "" }
  while i < text.length {
    let ch = text[i]
    let o = ord(ch)
    if o < 32 || (o >= 127 && o < 160) { let out = "@{ out }?" }
    else { let out = "@{ out }@{ ch }" }
    let i = i + 1
  }
  return out
}

fn home_of() {
  let h = getenv("BTR_HOME")
  if h == null || h == "" { let h = getenv("HOME") }
  if h == null { return "" }
  return h
}

fn short_dir(pwd, home) {
  let prefix = ""
  if pwd == null || pwd == "" { return "?" }
  if home == null || home == "" || home == "/" { return pwd }
  if pwd == home { return "~" }
  let prefix = "@{ home }/"
  if strings.starts(pwd, prefix) {
    return "~/@{ pwd.slice(prefix.length, pwd.length) }"
  }
  return pwd
}

fn has_name(list, name) {
  let i = 0
  while i < list.length {
    if list[i] == name { return true }
    let i = i + 1
  }
  return false
}

fn on_off(list, name) {
  if has_name(list, name) { return "1" }
  return "0"
}

fn load_conf(path) {
  let theme_name = "nord"
  let segs = []
  let plugs = []
  let saw_seg = false
  let saw_plug = false
  if path != "" && fs.exists(path) {
    let text = fs.read(path)
    if text != null {
      let lines = text.split("\n")
      let i = 0
      while i < lines.length {
        let line = lines[i].trim()
        let i = i + 1
        if line.length > 0 && line[0] != "#" {
          let got = theme.field(line)
          if got != null {
            if got.head == "theme" { let theme_name = got.rest }
            else if got.head == "segment" {
              let saw_seg = true
              let segs = segs.push(got.rest)
            } else if got.head == "plugin" {
              let saw_plug = true
              let plugs = plugs.push(got.rest)
            }
          }
        }
      }
    }
  }
  if !saw_seg {
    let segs = []
    let segs = segs.push("dir")
    let segs = segs.push("git")
    let segs = segs.push("status")
    let segs = segs.push("duration")
  }
  if !saw_plug {
    let plugs = []
    let plugs = plugs.push("suggest")
    let plugs = plugs.push("complete")
    let plugs = plugs.push("syntax")
  }
  return { theme: theme_name, segments: segs, plugins: plugs }
}

fn ahead_text(colors) {
  let at = "@"
  let raw = capture("git rev-list --left-right --count HEAD...@{ at }{upstream} 2>/dev/null || true").trim()
  let ahead = 0
  let behind = 0
  let out = ""
  if raw == "" { return "" }
  let ahead = parse_int(raw)
  let behind = second_num(raw)
  if ahead > 0 {
    let up = theme.wrap(colors.constant, "↑@{ ahead }")
    let out = "@{ out } @{ up }"
  }
  if behind > 0 {
    let down = theme.wrap(colors.constant, "↓@{ behind }")
    let out = "@{ out } @{ down }"
  }
  return out
}

fn git_piece(colors) {
  let branch = plain_text(capture("git rev-parse --abbrev-ref HEAD 2>/dev/null || true").trim())
  let shown = ""
  if branch == "" || branch == "HEAD" { return "" }
  let shown = theme.wrap(colors.function, branch)
  if capture("git status --porcelain 2>/dev/null || true").trim() != "" {
    let star = theme.wrap(colors.diag, "*")
    let shown = "@{ shown }@{ star }"
  }
  return "@{ shown }@{ ahead_text(colors) }"
}

fn duration_piece(colors) {
  let ms = parse_int(getenv("BTR_MS"))
  if ms < 2000 { return "" }
  return theme.wrap(colors.hint, "@{ ms / 1000 }s")
}

fn time_piece(colors) {
  let clock = plain_text(capture("date +%H:%M 2>/dev/null || true").trim())
  if clock == "" { return "" }
  return theme.wrap(colors.hint, clock)
}

fn user_piece(name, colors) {
  let home = home_of()
  let path = ""
  let bin = getenv("BTR_BIN")
  let out = ""
  if !safe_name(name) {
    eprintln("btr: @{ name }: bad addon name")
    return ""
  }
  if home == "" {
    eprintln("btr: @{ name }: addon not found")
    return ""
  }
  let path = "@{ home }/.bettersh/btr/@{ name }.btr"
  if !fs.exists(path) {
    eprintln("btr: @{ name }: addon not found")
    return ""
  }
  if bin == null || bin == "" { let bin = "bettersh" }
  let out = capture("@{ quote(bin) } @{ quote(path) } || true").trim()
  if out == "" { return "" }
  if out.contains(chr(27)) { return out }
  return theme.wrap(colors.text, out)
}

fn join_row(row, piece) {
  if piece == null || piece == "" { return row }
  if row == "" { return piece }
  return "@{ row } @{ piece }"
}

fn piece_of(name, colors, short) {
  if name == "dir" { return theme.wrap(colors.keyword, short) }
  if name == "git" { return git_piece(colors) }
  if name == "status" || name == "suggest" || name == "complete" || name == "syntax" { return "" }
  if name == "time" { return time_piece(colors) }
  if name == "duration" { return duration_piece(colors) }
  return user_piece(name, colors)
}

fn emit_header(colors, plugs) {
  let dim = theme.sgr(colors.hint)
  if dim == "" { let dim = "2" }
  io.writeln("K@{ theme.sgr(colors.keyword) }")
  io.writeln("S@{ theme.sgr(colors.string) }")
  io.writeln("C@{ theme.sgr(colors.comment) }")
  io.writeln("T@{ theme.sgr(colors.text) }")
  io.writeln("N@{ theme.sgr(colors.number) }")
  io.writeln("D@{ dim }")
  io.writeln("X@{ on_off(plugs, "syntax") }")
  io.writeln("U@{ on_off(plugs, "suggest") }")
  io.writeln("M@{ on_off(plugs, "complete") }")
}

fn emit_cont(colors, plugs) {
  emit_header(colors, plugs)
  io.write(chr(30))
  io.write(theme.wrap(colors.hint, "❯ "))
}

fn emit_prompt(colors, segs, plugs) {
  let pwd = getenv("BTR_PWD")
  let code = getenv("BTR_STATUS")
  let short = "?"
  let row = ""
  let line2 = ""
  let mark = "❯"
  let i = 0
  let show_status = has_name(segs, "status")
  if pwd == null { let pwd = "" }
  if code == null || code == "" { let code = "0" }
  let short = plain_text(short_dir(pwd, home_of()))
  emit_header(colors, plugs)
  io.write(chr(30))
  while i < segs.length {
    let name = segs[i]
    let i = i + 1
    let row = join_row(row, piece_of(name, colors, short))
  }
  if code == "0" {
    let line2 = theme.wrap(colors.string, mark)
  } else if show_status {
    let line2 = theme.wrap(colors.diag, "@{ mark } @{ code }")
  } else {
    let line2 = theme.wrap(colors.diag, mark)
  }
  if row == "" { io.write("@{ line2 } ") }
  else { io.write("@{ row }\n@{ line2 } ") }
}

let home = home_of()
let path = ""
if home != "" { let path = "@{ home }/.bettersh/btr.conf" }
let cfg = load_conf(path)
let colors = theme.preset(cfg.theme)
if colors == null { let colors = theme.nord() }
if getenv("BTR_CONT") == "1" { emit_cont(colors, cfg.plugins) }
else { emit_prompt(colors, cfg.segments, cfg.plugins) }
