#!/usr/bin/env bettersh

# Returns the bytes of p from start up to, but not including, end. A start below 0 is 0. An end past the length is the length. An empty span is "".
fn slice(p, start, end) {
  if start < 0 { let start = 0 }
  if end > p.length { let end = p.length }
  if start >= end { return "" }
  let out = ""
  let i = start
  while i < end {
    let out = "@{ out }@{ p[i] }"
    let i = i + 1
  }
  return out
}

# Returns the text after the last slash, or p when there is none.
fn base(p) {
  let i = p.length
  while i > 0 {
    let i = i - 1
    if p[i] == "/" { return slice(p, i + 1, p.length) }
  }
  return p
}

# Returns the text before the last slash. A path with no slash is "". The root is "/".
fn dir(p) {
  let i = p.length
  while i > 0 {
    let i = i - 1
    if p[i] == "/" {
      if i == 0 { return "/" }
      return slice(p, 0, i)
    }
  }
  return ""
}

# Returns the suffix after the last dot in the base name. A leading dot, or no dot, is "".
fn ext(p) {
  let name = base(p)
  let i = name.length
  while i > 0 {
    let i = i - 1
    if name[i] == "." {
      if i == 0 { return "" }
      return slice(name, i + 1, name.length)
    }
  }
  return ""
}

# Returns the base name without its extension or the dot before it.
fn stem(p) {
  let name = base(p)
  let e = ext(name)
  if e.length == 0 { return name }
  return slice(name, 0, name.length - e.length - 1)
}

# Joins a and b with one slash. An empty a is b. A trailing slash on a is kept.
fn join(a, b) {
  if a.length == 0 { return b }
  if a[a.length - 1] == "/" { return "@{ a }@{ b }" }
  return "@{ a }/@{ b }"
}

# Returns true when p begins with "/".
fn is_abs(p) {
  if p.length == 0 { return false }
  return p[0] == "/"
}
