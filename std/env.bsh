#!/usr/bin/env bettersh

# Returns the value of name, or null when it is unset.
fn get(name) {
  return getenv(name)
}

# Returns true when name is set, including when the value is empty.
fn has(name) {
  if getenv(name) == null { return false }
  return true
}

# Sets name to value, replacing any previous value, and returns null.
fn set(name, value) {
  return setenv(name, value)
}
