#!/usr/bin/env bettersh

fn bucket(n) {
  case n {
    0: return "none"
    1..9: return "few"
    10..: return "many"
    *: return "other"
  }
}

let n = 0
while n < 12 {
  println("@{ n } @{ bucket(n) }")
  n += 1
}

# break leaves a loop, continue skips to its next turn.
for i in 1..20 {
  if i % 3 != 0 { continue }
  if i > 10 { break }
  println("fizz @{ i }")
}
