#!/usr/bin/env bettersh

let nums = [1, 2, 3, 4]
let doubled = nums.map(fn(n) { return n * 2 })
println(doubled.join(","))

let user = { name: "ada", role: "dev" }
println("@{ user.name } is a @{ user.role }")
println(user.name + " has " + nums.length + " numbers")

let total = 0
for n in doubled {
  total += n
}
println(total)
