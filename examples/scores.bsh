#!/usr/bin/env bettersh

let rows = [
  { name: "ada", score: 91 },
  { name: "bea", score: 70 },
  { name: "cam", score: 88 }
]
let passed = rows.filter(fn(row) { (row.score >= 80) })
println(passed.map(fn(row) { row.name }).join(","))
let total = rows.reduce(fn(acc, row) { (acc + row.score) }, 0)
println(total)
let best = rows.reduce(fn(acc, row) {
  if row.score > acc.score { return row }
  return acc
})
println("@{ best.name } @{ best.score }")
