#!/usr/bin/env bettersh

fn counter(start) {
  # push and pop change this array. The function closes over that cell.
  let box = [start]
  fn() {
    let n = box[0] + 1
    box.pop()
    box.push(n)
    return n
  }
}

let next = counter(10)
println(next())
println(next())
println(next())
let other = counter(0)
println(other())
println(next())
