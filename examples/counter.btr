#!/usr/bin/env bettersh

fn counter(start) {
  let n = start
  # The inner function changes n in counter's call. Each counter has its own n.
  return fn() {
    n += 1
    return n
  }
}

let next = counter(10)
println(next())
println(next())
println(next())
let other = counter(0)
println(other())
println(next())
