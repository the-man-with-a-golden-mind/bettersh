#!/usr/bin/env bettersh
# Typing, motions, selections, undo, and the file format.
import std/edit
import std/edit_doc as doc

fn show(e, label) {
  println("@{ label }: @{ edit.sels(e) } [@{ edit.text(e).replace("\n", "|") }]")
}

let e = edit.app(60, 12)
edit.load(e, "fooBar baz_qux\n    indented line\nlast\n", "a.txt")
show(e, "start")
edit.key(e, "ctrl-right")
show(e, "word right")
edit.key(e, "ctrl-right")
show(e, "word right 2")
edit.key(e, "ctrl-left")
show(e, "word left")
edit.keys_in(e, ["home", "alt-right"])
show(e, "subword right")
edit.key(e, "alt-right")
show(e, "subword right 2")
edit.key(e, "alt-left")
show(e, "subword left")
edit.keys_in(e, ["down", "home"])
show(e, "smart home")
edit.key(e, "home")
show(e, "home again")
edit.key(e, "end")
show(e, "end")
edit.key(e, "up")
show(e, "up keeps goal")
edit.key(e, "down")
show(e, "down keeps goal")
edit.keys_in(e, ["ctrl-home", "shift-down", "shift-right"])
show(e, "shift select")
edit.key(e, "left")
show(e, "left collapses")
edit.keys_in(e, ["shift-end", "right"])
show(e, "right collapses")
edit.keys_in(e, ["ctrl-home", "ctrl-shift-right", "ctrl-shift-right"])
show(e, "ctrl shift right")
edit.key(e, "up")
show(e, "up at top")
edit.key(e, "ctrl-end")
show(e, "doc end")
edit.key(e, "down")
show(e, "down at bottom")

let e = edit.app(60, 12)
edit.load(e, "", "new.txt")
edit.type_text(e, "hello world")
show(e, "typed")
edit.key(e, "ctrl-z")
show(e, "undo word")
edit.key(e, "ctrl-z")
show(e, "undo all")
println(doc.dirty(edit.current(e)))
edit.key(e, "ctrl-y")
show(e, "redo")
println(doc.dirty(edit.current(e)))
edit.key(e, "ctrl-a")
edit.type_text(e, "x")
show(e, "replace all")
edit.keys_in(e, ["backspace", "backspace"])
show(e, "backspace empty")

let e = edit.app(60, 12)
edit.load(e, "    ab\n", "spaces.py")
edit.key(e, "end")
edit.key(e, "home")
edit.type_text(e, "\t")
show(e, "tab in spaces")
edit.key(e, "backspace")
show(e, "backspace to stop")
edit.key(e, "backspace")
show(e, "backspace again")

let e = edit.app(60, 12)
edit.load(e, "x\n", "t.js")
edit.key(e, "end")
edit.type_text(e, "f(")
show(e, "pair paren")
edit.type_text(e, "a")
edit.type_text(e, ")")
show(e, "skip closer")
edit.type_text(e, " [")
edit.key(e, "backspace")
show(e, "backspace pair")
edit.type_text(e, " \"s")
show(e, "pair quote")
edit.key(e, "end")
edit.type_text(e, " it's")
show(e, "apostrophe")
edit.keys_in(e, ["home", "shift-end"])
edit.type_text(e, "(")
show(e, "wrap selection")

let e = edit.app(60, 12)
edit.load(e, "def f():\n", "a.py")
edit.key(e, "end")
edit.type_text(e, "\npass\n")
show(e, "python indent")
let e = edit.app(60, 12)
edit.load(e, "fn x() {}\n", "a.btr")
edit.keys_in(e, ["end", "left"])
edit.key(e, "enter")
show(e, "split braces")
edit.type_text(e, "y")
edit.keys_in(e, ["down", "end", "enter"])
show(e, "after brace")
let e = edit.app(60, 12)
edit.load(e, "  a  \n  \n", "w.txt")
edit.keys_in(e, ["down", "end", "enter"])
show(e, "blank line enter")

let e = edit.app(60, 12)
edit.load(e, "a\r\nb\r\n", "crlf.txt")
let d = edit.current(e)
println(d.crlf)
println(doc.file_text(d) == "a@{ chr(13) }\nb@{ chr(13) }\n")
println(edit.frame(e).contains("Windows"))
edit.load(e, "no newline", "bare.txt")
println(doc.file_text(edit.current(e)) == "no newline")
edit.load(e, "\tone\n\t\ttwo\n", "tabs.c")
println(edit.current(e).spaces)
edit.load(e, "  one\n    two\n      three\n", "two.js")
println(edit.current(e).tab)
