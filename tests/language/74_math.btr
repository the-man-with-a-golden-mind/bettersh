#!/usr/bin/env bettersh
import std/math
println(math.pi())
println(math.e())
println(math.tau())
println(math.deg(math.pi()))
println(math.rad(180))
println(math.log10(1000))
println(math.log2(8))
println(math.cbrt(27))
println(math.exp2(4))
println(math.expm1(0))
println(math.log1p(0))
println(math.trunc(0 - 1.9))
println(math.sinh(0))
println(math.cosh(0))
println(math.tanh(0))
println(math.asinh(0))
println(math.acosh(1))
println(math.atanh(0))
println(math.tgamma(6))
println(math.lgamma(1))
println(math.fmod(5.5, 2))
println(math.remainder(5, 2))
println(math.copysign(3, 0 - 2))
println(math.round_to(1.239, 2))
println(math.lerp(0, 10, 0.5))
println(math.sum([1, 2, 3]))
println(math.sum([]))
println(math.mean([1, 2, 3]))
println(math.mean([]))
println(math.median([3, 1, 2]))
println(math.median([1, 2, 3, 4]))
println(math.median([]))
println(math.choose(5, 2))
println(math.choose(5, 0))
println(math.choose(3, 5))
println(math.choose(0 - 1, 1))
