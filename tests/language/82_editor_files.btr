#!/usr/bin/env bettersh
# Line commands and multiple selections.
import std/edit

fn show(e, label) {
  println("@{ label }: @{ edit.sels(e) } [@{ edit.text(e).replace("\n", "|") }]")
}

let e = edit.app(60, 14)
edit.load(e, "one\ntwo\nthree\nfour\n", "l.txt")
edit.key(e, "ctrl-shift-d")
show(e, "duplicate")
edit.key(e, "ctrl-shift-k")
show(e, "delete line")
edit.key(e, "alt-down")
show(e, "swap down")
edit.key(e, "ctrl-shift-up")
show(e, "swap up")
edit.keys_in(e, ["shift-down", "shift-down", "alt-down"])
show(e, "swap block")
edit.keys_in(e, ["escape", "ctrl-home", "ctrl-j"])
show(e, "join")
edit.key(e, "ctrl-z")
show(e, "undo join")
edit.key(e, "ctrl-enter")
show(e, "line after")
edit.type_text(e, "new")
edit.key(e, "ctrl-shift-enter")
show(e, "line before")
edit.keys_in(e, ["ctrl-a", "f9"])
show(e, "sort")
edit.keys_in(e, ["ctrl-home", "ctrl-k", "ctrl-u"])
show(e, "upper word")
edit.keys_in(e, ["ctrl-k", "ctrl-l"])
show(e, "lower word")
edit.keys_in(e, ["escape", "ctrl-home", "right", "ctrl-t"])
show(e, "transpose")
edit.keys_in(e, ["ctrl-home", "ctrl-l"])
show(e, "select line")
edit.key(e, "ctrl-l")
show(e, "select line 2")
edit.key(e, "ctrl-x")
show(e, "cut lines")
edit.keys_in(e, ["ctrl-home", "ctrl-v"])
show(e, "paste lines")
edit.keys_in(e, ["ctrl-home", "ctrl-c", "down", "ctrl-v"])
show(e, "line copy paste")
edit.keys_in(e, ["ctrl-home", "end", "ctrl-k", "ctrl-k"])
show(e, "delete to eol joins")
edit.keys_in(e, ["end", "ctrl-shift-backspace"])
show(e, "delete to bol")

let e = edit.app(60, 14)
edit.load(e, "a\n  b\n\nc\n", "x.btr")
edit.keys_in(e, ["ctrl-a", "ctrl-/"])
show(e, "comment")
edit.key(e, "ctrl-/")
show(e, "uncomment")
edit.keys_in(e, ["ctrl-a", "tab"])
show(e, "indent")
edit.key(e, "shift-tab")
show(e, "unindent")
edit.load(e, "x = 1\n", "y.rs")
edit.key(e, "ctrl-/")
show(e, "rust comment")

let e = edit.app(60, 14)
edit.load(e, "item foo\nitem bar\nitem baz\nother item\n", "m.txt")
edit.keys_in(e, ["ctrl-d", "ctrl-d", "ctrl-d"])
show(e, "ctrl-d x3")
edit.type_text(e, "row")
show(e, "typed at three")
edit.keys_in(e, ["ctrl-z", "escape"])
show(e, "undo and single")
edit.keys_in(e, ["ctrl-home", "ctrl-d", "ctrl-d", "ctrl-k", "ctrl-d"])
show(e, "skip")
edit.keys_in(e, ["escape", "alt-f3"])
show(e, "find all")
edit.keys_in(e, ["escape", "ctrl-home", "ctrl-alt-down", "ctrl-alt-down", "end"])
show(e, "carets at ends")
edit.type_text(e, ";")
show(e, "typed at ends")
edit.keys_in(e, ["escape", "ctrl-a", "ctrl-shift-l"])
show(e, "split lines")
edit.keys_in(e, ["home", "shift-ctrl-right", "ctrl-c", "escape", "ctrl-end"])
edit.key(e, "ctrl-v")
show(e, "paste joined")
edit.keys_in(e, ["ctrl-home", "alt-shift-down", "alt-shift-down", "alt-shift-down", "ctrl-v"])
show(e, "paste spread")
edit.keys_in(e, ["escape", "ctrl-home", "ctrl-shift-m"])
show(e, "no brackets")

let e = edit.app(60, 14)
edit.load(e, "f(a, [b, c], d)\n", "b.js")
edit.keys_in(e, ["ctrl-home", "right", "right", "right", "right", "right", "right", "ctrl-shift-m"])
show(e, "inside brackets")
edit.key(e, "ctrl-shift-m")
show(e, "with brackets")
edit.key(e, "ctrl-shift-m")
show(e, "outer")
edit.keys_in(e, ["escape", "ctrl-home", "right", "ctrl-m"])
show(e, "jump to match")
edit.key(e, "ctrl-m")
show(e, "jump back")
