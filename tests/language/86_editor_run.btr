#!/usr/bin/env bettersh
# The panel: a shell line, the bettersh REPL, and running the file.
import std/edit
import std/edit_run

let e = edit.app(64, 20)
edit.load(e, "println(\"RUN\")\nlet z = 1\n", "work.btr")
println(edit_run.is_open())
edit.key(e, "ctrl-\\")
println(edit_run.is_open())
println(edit_run.focused())
println(e.focus)
println(edit_run.mode())
edit.type_text(e, "echo hi")
edit.key(e, "enter")
edit.type_text(e, "false")
edit.key(e, "enter")
println(edit_run.text())
edit.key(e, "tab")
println(edit_run.mode())
edit.type_text(e, "let n = 4")
edit.key(e, "enter")
edit.type_text(e, "println(n * 2)")
edit.key(e, "enter")
edit.type_text(e, "fn f() {")
edit.key(e, "enter")
edit.type_text(e, "return 7 }")
edit.key(e, "enter")
edit.type_text(e, "println(f())")
edit.key(e, "enter")
edit.key(e, "up")
edit.key(e, "up")
println(e.focus)
edit.key(e, "escape")
println(e.focus)
println(edit_run.focused())
edit.key(e, "ctrl-b")
println(edit_run.mode())
println(edit_run.text())
println(edit.frame(e))
edit.key(e, "escape")
edit.key(e, "down")
println(edit.sels(e))
edit.key(e, "ctrl-`")
println(edit_run.is_open())
println(e.focus)
