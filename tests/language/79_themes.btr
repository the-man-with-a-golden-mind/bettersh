#!/usr/bin/env bettersh
import std/theme
import std/edit

fn show(name) {
  let t = theme.load("theme name @{ name }")
  println(name)
  println(t != null)
  println(theme.themed(t))
  println(t.keyword)
  println(t.function)
  println(t.string)
  println(t.comment)
  println(t.type)
  println(t.constant)
  println(t.macro)
  println(t.variable)
  println(t.number)
  println(t.text)
  println(t.gutter)
  println(t.status)
  println(t.hint)
  println(t.diag)
  let wrapped = theme.wrap(t.keyword, "k")
  if name == "plain" { println(wrapped == "k") }
  else if name == "dark" { println(wrapped.contains("[35m")) }
  else { println(wrapped.contains("38;2;")) }
}

show("plain")
show("dark")
show("light")
show("nord")
show("gruvbox")
show("dracula")
show("catppuccin")
show("solarized")
show("monokai")
show("tokyonight")

let nord = theme.load("theme name nord")
let dracula = theme.load("theme name dracula")
let gruvbox = theme.load("theme name gruvbox")
let mono = theme.load("theme name monokai")
let cat = theme.load("theme name catppuccin")
let mocha = theme.load("theme name mocha")
println(nord.keyword != dracula.keyword)
println(nord.keyword != gruvbox.keyword)
println(mono.keyword != cat.keyword)
println(mocha.keyword == cat.keyword)
println(theme.wrap(nord.keyword, "k") != theme.wrap(theme.dark().keyword, "k"))
println(theme.load("theme name nope") == null)
println(theme.load("theme function 38;2;1;2;3") == null)
println(theme.load("theme name nord extra") == null)
let mixed = theme.load("theme name nord\ntheme keyword red\ntheme name dark")
println(mixed.keyword == "magenta")
println(mixed.function == "cyan")
println(mixed.text == "")
let over = theme.load("theme name nord\ntheme function cyan")
println(over.function == "cyan")
println(over.keyword == nord.keyword)
println(theme.wrap("red", "ab") == "@{ chr(27) }[31mab@{ chr(27) }[0m")
println(theme.wrap("", "ab") == "ab")
println(theme.wrap("nope", "ab") == "ab")
println(theme.dark().keyword == "magenta")
println(theme.dark().string == "green")
println(theme.dark().comment == "dim")
println(theme.dark().number == "yellow")
println(theme.themed(theme.plain()) == false)

let e = edit.app_with(48, 6, nord)
edit.load(e, "def foo(Name) = None # hi\n", "a.py")
println(edit.frame(e).contains(chr(27)))
println("DRAW")
println(edit.paint(e))
println("TXT")
let e = edit.app_with(32, 5, nord)
edit.load(e, "let x\n", "a.txt")
println(edit.paint(e))
