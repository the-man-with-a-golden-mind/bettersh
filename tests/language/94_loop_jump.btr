#!/usr/bin/env bettersh
# break and continue in every kind of loop, nested and inside case.
let seen = []
for i in 1..10 {
  if i % 2 == 0 { continue }
  if i > 7 { break }
  seen.push(i)
}
println(seen)

let n = 0
while true {
  n += 1
  if n < 4 { continue }
  break
}
println(n)

for word in ["a", "b", "c"] {
  for k in [1, 2, 3] {
    if k == 2 { break }
    print(word)
  }
  case word {
    "b": continue
    *: print("!")
  }
}
println("")
