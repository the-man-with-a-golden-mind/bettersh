#!/usr/bin/env bettersh
# name = value changes the nearest name that exists. let always makes a new one.
let count = 0
fn bump() {
  count = count + 1
}
bump()
bump()
println(count)

fn counter() {
  let total = 0
  fn add(k) {
    total += k
    return total
  }
  return add
}
let add = counter()
add(2)
println(add(3))

fn shadow() {
  let count = 100
  count -= 1
  return count
}
println(shadow())
println(count)

let parts = ""
for i in 1..3 { parts = parts + i }
println(parts)
