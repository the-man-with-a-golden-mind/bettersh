#!/usr/bin/env bettersh
import std/ui
import std/edit

let s = ui.blank(10, 4)
let s = ui.box(s, 0, 0, 4, 10, "hi")
let s = ui.put(s, 2, 2, "ok")
println(ui.paint(s))

let ev = ui.feed("", chr(65))
println(ev.key)
let ev = ui.feed("", chr(27))
let ev = ui.feed(ev.pending, "[")
let ev = ui.feed(ev.pending, "A")
println(ev.key)
let ev = ui.feed(chr(27), "Z")
println(ev.key)
println(ev.extra)
let ev = ui.flush(chr(27))
println(ev.key)
let ev = ui.feed("", chr(13))
println(ev.key)
let ev = ui.feed("", chr(127))
println(ev.key)
let ev = ui.feed("", chr(3))
println(ev.key)
let ev = ui.feed("", chr(19))
println(ev.key)
let p = ui.feed("", chr(27)).pending
let p = ui.feed(p, "[").pending
let p = ui.feed(p, "3").pending
println(ui.feed(p, "~").key)
let p = ui.feed("", chr(27)).pending
let p = ui.feed(p, "O").pending
println(ui.feed(p, "D").key)

let b = edit.buffer("one\ntwo\n", "note.txt")
println(edit.text(b))
println(edit.save_text(b))
let b = edit.press(b, "j")
let b = edit.press(b, "x")
println(edit.text(b))
println(b.dirty)
let b = edit.press(b, "i")
let b = edit.press(b, "Q")
let b = edit.press(b, "Z")
let b = edit.press(b, "escape")
println(edit.text(b))
let b = edit.press(b, "u")
println(edit.text(b))
let b = edit.press(b, "y")
let b = edit.press(b, "y")
let b = edit.press(b, "p")
println(edit.text(b))
let b = edit.press(b, "d")
let b = edit.press(b, "d")
println(edit.text(b))
let b = edit.press(b, "G")
println(b.row)
let b = edit.press(b, "g")
let b = edit.press(b, "g")
println(b.row)

let b = edit.buffer("cat\nhat\ncap\n", "note.txt")
let b = edit.press(b, "/")
let b = edit.press(b, "a")
let b = edit.press(b, "t")
let b = edit.press(b, "enter")
println("@{ b.row }:@{ b.col }")
let b = edit.press(b, "n")
println("@{ b.row }:@{ b.col }")
let b = edit.press(b, "N")
println("@{ b.row }:@{ b.col }")
let b = edit.press(b, ":")
let b = edit.press(b, "w")
let b = edit.press(b, "enter")
println(b.request)
let b = edit.press(b, ":")
let b = edit.press(b, "2")
let b = edit.press(b, "enter")
println(b.row)

let b = edit.buffer("ab\n", "t")
let b = edit.press(b, "ctrl-c")
println(b.request)
let b = edit.buffer("ab\n", "t")
let b = edit.press(b, "ctrl-s")
println(b.request)
let b = edit.buffer("ab\n", "t")
let b = edit.press(b, "i")
let b = edit.press(b, "Z")
let b = edit.press(b, "escape")
let b = edit.press(b, "q")
println(b.confirm)
println(b.request == "")
let b = edit.press(b, "q")
println(b.request)
let b = edit.buffer("ab\n", "t")
let b = edit.press(b, "i")
let b = edit.press(b, "Z")
let b = edit.press(b, "escape")
let b = edit.press(b, ":")
let b = edit.press(b, "q")
let b = edit.press(b, "!")
let b = edit.press(b, "enter")
println(b.request)
let b = edit.buffer("ab\ncd\n", "t")
let b = edit.press(b, "j")
let b = edit.press(b, "i")
let b = edit.press(b, "backspace")
println(edit.text(b))
let b = edit.buffer("ab\n", "t")
let b = edit.press(b, "o")
let b = edit.press(b, "Z")
let b = edit.press(b, "escape")
println(edit.text(b))
let b = edit.press(b, "u")
println(edit.text(b))
let b = edit.press(b, "a")
let b = edit.press(b, "Y")
let b = edit.press(b, "escape")
println(edit.text(b))
println(edit.frame(edit.buffer("ab\ncd\n", "note.txt"), 40, 6))
