#!/usr/bin/env bettersh
let nums = [1, 2, 3, 4]
println(nums.reduce(fn(a, b) { (a + b) }))
println(nums.reduce(fn(a, b) { (a + b) }, 10))
println(nums.filter(fn(n) { (n % 2 == 0) }).join(","))
println(nums.map(fn(n) { (n * n) }).join(","))
println(nums.slice(1, 3))
println(nums.slice(0, 0))
println(nums.pop())
println(nums.join(","))
println([].pop() == null)
println(nums.slice(1, 3).map(fn(n) { (n * 10) }).join(","))
let inner = [1]
let wrapped = [inner].slice(0, 1)
inner.push(2)
println(wrapped[0].join(","))
println([[9], [8], [7]].slice(0, 2))
println([].slice(0, 1).length)
println([1, 2, 3].slice(0 - 1, 10).join(","))
println("abcd".slice(1, 3))
