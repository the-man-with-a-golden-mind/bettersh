let lines = []
let i = 0
while i < 30 {
  let lines = lines.push("line")
  let i = i + 1
}
let b = edit.buffer(lines.join("\n"), "scroll.txt")
let b = edit.press(b, "G")
let b = edit.fit(b, 40, 10)
println(b.top)
println(b.row)
let held = b.top
let b = edit.press(b, "x")
let b = edit.press(b, "u")
println(b.top == held)
let b = edit.press(b, "k")
let b = edit.fit(b, 40, 10)
println(b.top == held)
println(b.row)

let chars = []
let i = 0
while i < 40 {
  let chars = chars.push("a")
  let i = i + 1
}
let chars = chars.push("E")
let chars = chars.push("N")
let chars = chars.push("D")
let b = edit.buffer(chars.join(""), "wide.txt")
let b = edit.press(b, "$")
let b = edit.fit(b, 20, 6)
println(b.left)
let held = b.left
let b = edit.press(b, "h")
let b = edit.fit(b, 20, 6)
println(b.left == held)
println(edit.frame(b, 20, 6).contains("END"))

let ev = ui.feed("", unbytes([195]))
println(ev.key == null)
let ev = ui.feed(ev.pending, unbytes([169]))
println(ev.key.length)
let b = edit.buffer("", "utf.txt")
let b = edit.press(b, "i")
let b = edit.press(b, ev.key)
println(edit.text(b))
println(b.col)

