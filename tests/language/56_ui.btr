#!/usr/bin/env bettersh
import std/ui

let s = ui.blank(10, 4)
let s = ui.box(s, 0, 0, 4, 10, "hi")
let s = ui.put(s, 2, 2, "ok")
println(ui.paint(s))

# One byte at a time.
let ev = ui.feed("", chr(65))
println(ev.key)
let ev = ui.feed("", chr(27))
let ev = ui.feed(ev.pending, "[")
let ev = ui.feed(ev.pending, "A")
println(ev.key)
let ev = ui.feed(chr(27), "Z")
println(ev.key)
println(ev.extra)
let ev = ui.flush(chr(27))
println(ev.key)
let ev = ui.feed("", chr(13))
println(ev.key)
let ev = ui.feed("", chr(127))
println(ev.key)
let ev = ui.feed("", chr(3))
println(ev.key)
let ev = ui.feed("", chr(19))
println(ev.key)
let p = ui.feed("", chr(27)).pending
let p = ui.feed(p, "[").pending
let p = ui.feed(p, "3").pending
println(ui.feed(p, "~").key)
let p = ui.feed("", chr(27)).pending
let p = ui.feed(p, "O").pending
println(ui.feed(p, "D").key)
println(ui.feed("", chr(4)).key)
println(ui.feed("", chr(18)).key)
println(ui.feed("", chr(23)).key)
println(ui.feed("", chr(31)).key)
let ev = ui.feed("", unbytes([195]))
println(ev.key == null)
let ev = ui.feed(ev.pending, unbytes([169]))
println(ev.key.length)

# Modifiers in escape sequences.
let e = chr(27)
println(ui.named("@{ e }[1;5D"))
println(ui.named("@{ e }[1;2A"))
println(ui.named("@{ e }[1;6C"))
println(ui.named("@{ e }[1;3B"))
println(ui.named("@{ e }[5;5~"))
println(ui.named("@{ e }[3;2~"))
println(ui.named("@{ e }[15~"))
println(ui.named("@{ e }[24;5~"))
println(ui.named("@{ e }OP"))
println(ui.named("@{ e }[112;6u"))
println(ui.named("@{ e }[27;5;13~"))
println(ui.named("@{ e }[99;5u"))
println(ui.named("@{ e }[96;5u"))
println(ui.named("@{ e }[27u"))
println(ui.named("@{ e }[127;5u"))
println(ui.named("@{ e }[1;9C"))
println(ui.named("@{ e }[99;1:3u"))
println(ui.named("@{ e }[Q") == "f2")
println(ui.named("@{ e }[9999~") == "")

# Whole chunks, the way the editor reads them.
fn names(chunk) {
  let got = ui.decode(chunk)
  let out = []
  let i = 0
  while i < got.events.length {
    let ev = got.events[i]
    let t = ev.key
    if ev.key == "mouse" { let t = "mouse:@{ ev.act }:@{ ev.button }:@{ ev.x }:@{ ev.y }:@{ ev.shift }:@{ ev.alt }:@{ ev.ctrl }:@{ ev.dir }" }
    if ev.key == "paste" || ev.key == "text" { let t = "@{ ev.key }[@{ ev.text.replace("\n", "/") }]" }
    let out = out.push(t)
    let i = i + 1
  }
  return "@{ out.join(" | ") } rest=@{ got.rest.length }"
}
println(names("ab"))
println(names("@{ e }[1;5A@{ e }[1;2C@{ e }[3;5~@{ e }[112;6u"))
println(names("@{ e }[<0;10;5M@{ e }[<0;10;5m@{ e }[<32;11;5M@{ e }[<65;3;3M@{ e }[<64;3;3M"))
println(names("@{ e }[<16;1;1M@{ e }[<8;2;2M@{ e }[<4;3;3M@{ e }[<2;4;4M@{ e }[<1;5;5M@{ e }[<35;6;6M"))
println(names("x@{ e }[200~hello@{ chr(13) }@{ chr(10) }world@{ chr(13) }end@{ e }[201~y"))
println(names("x@{ e }[200~half"))
println(names("@{ e }"))
println(names("@{ e }[1;5"))
println(names("@{ e }x@{ e }X@{ e }@{ chr(127) }@{ e }@{ chr(13) }@{ e } "))
println(names("ąę"))
println(names(unbytes([196])))
println(names("0123456789abcdefghij"))
println(names("@{ chr(0) }@{ chr(1) }@{ chr(8) }@{ chr(9) }@{ chr(13) }@{ chr(28) }@{ chr(29) }@{ chr(31) }"))
println(names("@{ e }OP@{ e }[15~@{ e }[24;2~@{ e }[Z@{ e }[I@{ e }[O"))
println(names("@{ e }[27u@{ e }[13;5u@{ e }[127;5u@{ e }[96;5u@{ e }[32;5u@{ e }[9;6u"))
println(names("@{ e }[?1;2c@{ e }[200;1~"))
let split = ui.decode("@{ e }[200~one")
let more = ui.decode("@{ split.rest } two@{ e }[201~")
println(names("@{ split.rest } two@{ e }[201~"))
println(more.rest == "")
println(ui.decode_flush(e)[0].key)
println(ui.decode_flush("@{ e }O")[0].key)
println(ui.decode_flush("@{ e }[200~cut")[0].text)
println(ui.decode_flush("").length)

println(ui.width("\t"))
println(ui.width("a\t"))
println(ui.width(chr(65313)))
println(ui.take("\t", 0, 20).length)
println(ui.take("a\t", 0, 20).length)
