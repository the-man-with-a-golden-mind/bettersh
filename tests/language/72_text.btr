#!/usr/bin/env bettersh
import std/text
import std/strings
let e = chr(233)
let s = "@{ e }x"
println(text.flip(s))
println(strings.reverse(s))
println(text.flip("") == "")
println(text.lines("").length)
println(text.lines("\n").join("|"))
println(text.lines("a\nb\n").join("|"))
println(text.lines("a\n\nb").join("|"))
println(text.fields("a\tb  c\n").join(","))
println(text.fields("@{ chr(12) }four @{ chr(11) }vs").join(","))
println(text.fields("  ").length)
println(text.before("a-b-c", "-"))
println(text.after("a-b-c", "-"))
println(text.before("abc", "-") == null)
println(text.before("a-", "") == null)
println(text.between("x{ab}y", "{", "}"))
println(text.between("no", "(", ")") == null)
println(text.truncate(s, 1))
println(text.truncate("hi", 0) == "")
println(text.ellipsize("hello", 4))
println(text.ellipsize("hi", 4))
println(text.ellipsize("hello", 2))
println(text.ellipsize("@{ e }abcd", 4))
println(text.wrap("one two three four", 10))
println(text.wrap("  ", 10) == "")
println(text.codepoints(s).join(","))
println(text.from_codes(text.codepoints(s)) == s)
println(text.from_codes([255]).length)
println(ord(text.from_codes([255])))
