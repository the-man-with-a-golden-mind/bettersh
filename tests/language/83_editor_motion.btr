#!/usr/bin/env bettersh
# Find, replace, and their options.
import std/edit

fn show(e, label) {
  let bar = ""
  if e.bar != null { let bar = " bar=@{ e.bar.at }/@{ e.bar.count }" }
  println("@{ label }: @{ edit.sels(e) }@{ bar } [@{ edit.text(e).replace("\n", "|") }] @{ e.msg }")
}

let e = edit.app(60, 10)
edit.load(e, "Cat cat\nconcat CAT\ncat\n", "f.txt")
edit.key(e, "ctrl-f")
edit.type_text(e, "cat")
show(e, "typed")
edit.key(e, "enter")
show(e, "next")
edit.key(e, "enter")
show(e, "next 2")
edit.key(e, "shift-enter")
show(e, "prev")
edit.key(e, "alt-c")
show(e, "case on")
edit.key(e, "alt-w")
show(e, "whole word")
edit.keys_in(e, ["enter", "enter", "enter"])
show(e, "wraps")
edit.key(e, "alt-enter")
show(e, "find all")
println(e.bar == null)
edit.keys_in(e, ["escape", "ctrl-home", "f3"])
show(e, "f3 after close")
edit.key(e, "shift-f3")
show(e, "shift-f3")

let e = edit.app(60, 10)
edit.load(e, "one two one\ntwo one\n", "r.txt")
edit.key(e, "ctrl-h")
edit.type_text(e, "one")
edit.key(e, "tab")
edit.type_text(e, "1")
show(e, "replace bar")
edit.key(e, "enter")
show(e, "replace first")
edit.key(e, "enter")
show(e, "replace second")
edit.key(e, "alt-enter")
show(e, "replace rest")
edit.key(e, "ctrl-z")
show(e, "undo replace all")
edit.key(e, "escape")
println(e.bar == null)
println(e.find.query)

let e = edit.app(60, 10)
edit.load(e, "alpha beta\nalpha\n", "s.txt")
edit.keys_in(e, ["ctrl-right", "shift-ctrl-left", "ctrl-f"])
show(e, "selection seeds find")
edit.type_text(e, "beta")
show(e, "typing replaces seed")
edit.key(e, "backspace")
show(e, "backspace")
edit.keys_in(e, ["ctrl-a", "backspace"])
show(e, "field cleared")
edit.type_text(e, "zzz")
show(e, "no match")
edit.key(e, "escape")
edit.keys_in(e, ["ctrl-home", "ctrl-f3"])
show(e, "quick find")
edit.key(e, "ctrl-f3")
show(e, "quick find again")

let e = edit.app(60, 10)
edit.load(e, "ab\ncd\nab\ncd\n", "m.txt")
edit.keys_in(e, ["ctrl-home", "shift-down", "shift-right", "shift-right", "ctrl-d"])
show(e, "multi-line ctrl-d")
edit.keys_in(e, ["escape", "ctrl-home", "shift-down", "ctrl-f", "enter"])
show(e, "multi-line find")
println(edit.frame(e).contains("Find:"))
