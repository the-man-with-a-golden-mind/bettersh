#!/usr/bin/env bettersh
import std/codec
let raw = unbytes([0, 255, 10, 65])
println(codec.hex(""))
println(codec.hex("hi"))
println(codec.hex(chr(233)))
println(codec.hex(raw))
println(codec.unhex("6869") == "hi")
println(codec.unhex("C3A9") == chr(233))
println(codec.unhex(codec.hex(raw)) == raw)
println(codec.base64(""))
println(codec.base64("a"))
println(codec.base64("ab"))
println(codec.base64("abc"))
println(codec.base64("hello"))
println(codec.base64(raw))
println(codec.unbase64(codec.base64(raw)) == raw)
println(codec.unbase64(codec.base64("")) == "")
println(bytes("A").join(","))
