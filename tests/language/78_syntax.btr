#!/usr/bin/env bettersh
import std/edit_syntax

fn show(which, lines, row) {
  let m = edit_syntax.line_marks(lines, row, which)
  println(m.length == lines[row].length)
  println(m)
}

println(edit_syntax.lang("a.js"))
println(edit_syntax.lang("a.mjs"))
println(edit_syntax.lang("a.jsx"))
println(edit_syntax.lang("a.ts"))
println(edit_syntax.lang("a.tsx"))
println(edit_syntax.lang("a.rs"))
println(edit_syntax.lang("a.sh"))
println(edit_syntax.lang("a.bash"))
println(edit_syntax.lang("a.bsh"))
println(edit_syntax.lang("a.btr"))
println(edit_syntax.lang("a.py"))
println(edit_syntax.lang("a.lua"))
println(edit_syntax.lang("a.txt"))
println(edit_syntax.lang(null))

show("btr", ["let x = 1 # hi"], 0)
show("btr", ["let a = \"hi\""], 0)
show("btr", ["'a\\'"], 0)
show("js", ["const n = 1 // x"], 0)
show("js", ["let s = \"a\""], 0)
show("js", ["/*", "let", "*/"], 1)
show("js", ["/*", "let", "*/"], 2)
show("ts", ["interface Name"], 0)
show("ts", ["type Age = 1"], 0)
show("rust", ["fn main() { let mut x = 1; }"], 0)
show("rust", ["let a = 'x';"], 0)
show("rust", ["fn f<'a>(x: &'a T)"], 0)
show("rust", ["let s = r#\"ab\"#;"], 0)
show("sh", ["if true; then echo \"hi\" # z"], 0)
show("sh", ["x='a\\''"], 0)
show("py", ["def f(n): return 1 # z"], 0)
show("py", ["r\"ab\\\"c\""], 0)
show("py", ["\"\"\"ab", "cd\"\"\""], 0)
show("py", ["\"\"\"ab", "cd\"\"\""], 1)
show("lua", ["local function f() return 1 end -- c"], 0)
show("lua", ["--[[", "local", "]]"], 1)
show("lua", ["--[[", "local", "]]"], 2)
show("lua", ["local s = [[ab]]"], 0)
show("", ["let x = 1"], 0)
show("js", ["foo(bar)"], 0)
show("js", ["foo ()"], 0)
show("js", ["let a = true"], 0)
show("js", ["obj.method()"], 0)
show("ts", ["@Dec class Name"], 0)
show("ts", ["let n: string = null"], 0)
show("rust", ["println!(1)"], 0)
show("rust", ["let n = a != b"], 0)
show("rust", ["let n: i32 = 1"], 0)
show("rust", ["#[derive(Debug)]"], 0)
show("rust", ["fn", "main()"], 1)
show("rust", ["break"], 0)
show("rust", ["let s = b\"ab\""], 0)
show("py", ["@dataclass", "def Point(x):"], 0)
show("py", ["@dataclass", "def Point(x):"], 1)
show("py", ["x = None"], 0)
show("py", ["n: int = 1"], 0)
show("sh", ["echo $HOME ${USER} $? $(ls) $1"], 0)
show("sh", ["function hi {"], 0)
show("sh", ["x=\"$HOME\""], 0)
show("btr", ["fn main() { let n = Name }"], 0)
show("lua", ["print(true)"], 0)
show("lua", ["local function", "f()"], 1)

# Shell text in a .btr file: upper-case marks, $ and % around it, @ around an inserted value.
show("btr", ['$ ls -l @{ dir } | wc # n'], 0)
show("btr", ["let b = $(git branch) + 1"], 0)
show("btr", ["sh {", "  if test -f x; then", "    echo \"$HOME\"", "  fi", "}", "let z = 2"], 1)
show("btr", ["sh {", "  if test -f x; then", "    echo \"$HOME\"", "  fi", "}", "let z = 2"], 2)
show("btr", ["sh {", "  if test -f x; then", "    echo \"$HOME\"", "  fi", "}", "let z = 2"], 4)
show("btr", ["sh {", "  if test -f x; then", "    echo \"$HOME\"", "  fi", "}", "let z = 2"], 5)
show("btr", ["if ok { $ echo hi }"], 0)
show("btr", ["$ ls |", "  wc -l", "let q = 1"], 1)
show("btr", ["$ ls |", "  wc -l", "let q = 1"], 2)
show("btr", ["let s = \"$ not shell\""], 0)
show("btr", ["sh { echo '}' ${x:-}; }", "let w = 1"], 1)
show("sh", ["echo $(date)"], 0)
println(edit_syntax.in_shell("S"))
println(edit_syntax.in_shell("s"))
println(edit_syntax.role_of("K"))
println(edit_syntax.role_of("%"))
println(edit_syntax.literal("C"))
