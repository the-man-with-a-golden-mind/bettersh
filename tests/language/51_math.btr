#!/usr/bin/env bettersh
import std/math
println(math.abs(0 - 4))
println(math.abs(4))
println(math.min(3, 1))
println(math.max(3, 1))
println(math.clamp(9, 0, 5))
println(math.clamp(0 - 3, 0, 5))
println(math.sign(0 - 2))
println(math.sign(0))
println(math.sign(8))
println(math.gcd(12, 18))
println(math.gcd(0 - 12, 18))
println(math.lcm(12, 18))
println(math.lcm(0, 5))
println(math.pow(2, 10))
println(math.pow(2, 0))
println(math.pow(2, 0 - 1))
println(math.fact(0))
println(math.fact(5))
println(math.fact(0 - 1))
println(math.sqrt(4))
println(math.floor(3.7))
println(math.ceil(3.2))
println(math.round(2.5))
println(math.sin(0))
println(math.cos(0))
println(math.tan(0))
println(math.asin(0))
println(math.acos(1))
println(math.atan(0))
println(math.atan2(0, 1))
println(math.atan2(1, 0))
println(math.log(1))
println(math.exp(0))
println(math.hypot(3, 4))
