#!/usr/bin/env bettersh
# Writes deterministic modern scripts. The runner compares --interp with the VM.
# The numbers come from a 32-bit LCG. They do not need to match any other
# generator. Each script uses one of the same construct kinds: logic, branches,
# loops, ranges, arrays, cases, functions, defaults, closures, or recursion,
# and sometimes a shared cell.
let rng = { n: 1 }

fn nxt() {
  let n = (rng.n * 1664525 + 1013904223) % 4294967296
  map_set(rng, "n", n)
  return n
}

fn span(a, b) {
  let n = nxt()
  let width = b - a + 1
  if n < 0 { let n = 0 - n }
  return a + (n % width)
}

fn below(n) {
  let x = nxt()
  if x < 0 { let x = 0 - x }
  return x % n
}

fn to_int(s) {
  let n = 0
  let i = 0
  if s == null || s.length == 0 { return 0 }
  while i < s.length {
    let n = n * 10 + (ord(s[i]) - 48)
    let i = i + 1
  }
  return n
}

fn pad4(n) {
  if n < 10 { return "000@{ n }" }
  if n < 100 { return "00@{ n }" }
  if n < 1000 { return "0@{ n }" }
  return "@{ n }"
}

fn logic(lines, names) {
  let a = names[0]
  let b = names[names.length - 1]
  let lit = span(-3, 5)
  lines.push("println(@{ a } && @{ b })")
  lines.push("println(@{ a } || @{ lit })")
  lines.push("println(@{ lit } && @{ b })")
  lines.push("println(0 && 5)")
  lines.push("println(1 && 5)")
  lines.push("println(1 || 5)")
  lines.push("println(0 || 5)")
  lines.push("println(\"a\" < \"b\")")
  lines.push("println(1 == 1.0)")
}

fn branches(lines, names) {
  let a = names[0]
  let bound = span(0, 3)
  lines.push("if @{ a } < 0 {")
  lines.push("  println(1)")
  lines.push("} else if @{ a } == 0 {")
  lines.push("  println(2)")
  lines.push("} else {")
  lines.push("  println(3)")
  lines.push("}")
  lines.push("let c = 0")
  lines.push("let w = 0")
  lines.push("while c < @{ bound } {")
  lines.push("  let w = w + @{ a }")
  lines.push("  let c = c + 1")
  lines.push("}")
  lines.push("println(w)")
}

fn loops(lines) {
  let a = span(0, 4)
  let b = span(0, 5)
  lines.push("let rs = 0")
  lines.push("for ri in @{ a }..@{ b } {")
  lines.push("  let rs = rs + ri")
  lines.push("}")
  lines.push("println(rs)")
  lines.push("let n0 = 7")
  lines.push("for n0 in 4..2 {")
  lines.push("  println(n0)")
  lines.push("}")
  lines.push("println(n0)")
}

fn ranges(lines) {
  let a = span(-2, 2)
  let b = span(0, 6)
  lines.push("let rs = 0")
  lines.push("for ri in @{ a }..@{ b } { let rs = rs + ri }")
  lines.push("println(rs)")
  lines.push("for zj in 3..1 { println(zj) }")
  lines.push("println(zj)")
}

fn arrays(lines) {
  let vals = []
  let n = span(0, 5)
  let k = 0
  while k < n {
    vals.push("@{ span(-4, 6) }")
    let k = k + 1
  }
  lines.push("let arr = [@{ vals.join(", ") }]")
  lines.push("let sum = 0")
  lines.push("for el in arr { let sum = sum + el }")
  lines.push("println(sum)")
  lines.push("println(el)")
}

fn cases(lines, names) {
  let src = names[below(names.length)]
  lines.push("case @{ src } {")
  lines.push("  0: println(0)")
  lines.push("  -1: println(4)")
  lines.push("  1..9: println(1)")
  lines.push("  10..: println(2)")
  lines.push("  *: println(3)")
  lines.push("}")
  lines.push("case \"a\" { \"a\": println(1) *: println(0) }")
}

fn functions(lines, names) {
  let arg = names[0]
  let lit = span(-2, 4)
  lines.push("fn plus(a, b) { (a + b) }")
  lines.push("println(plus(@{ arg }, @{ lit }))")
  lines.push("fn pick(n) { if n < 0 { return 0 - n }; return n }")
  lines.push("println(pick(@{ arg }))")
}

fn defaults(lines, names) {
  let lit = span(0, 3)
  lines.push("fn add(a, b = a) { (a + b) }")
  lines.push("println(add(@{ names[0] }))")
  lines.push("println(add(@{ names[names.length - 1] }, @{ lit }))")
  lines.push("fn greet(name, greeting = \"Hello\") { (greeting) }")
  lines.push("println(greet(\"Ada\"))")
  lines.push("println(greet(\"Ada\", \"Hi\"))")
  lines.push("fn opt(a = 1) { (a) }")
  lines.push("println(opt(null))")
  lines.push("println(opt())")
}

fn closures(lines) {
  let x = span(-3, 6)
  let y = span(-3, 6)
  lines.push("fn adder(n) { fn(x) { (x + n) } }")
  lines.push("println(adder(@{ x })(@{ y }))")
}

fn recur(lines) {
  let n = span(0, 6)
  lines.push("fn fact(n) { if n < 2 { return n }; return n * fact(n - 1) }")
  lines.push("println(fact(@{ n }))")
}

fn shared(lines) {
  lines.push("let cell = 1")
  lines.push("fn reader() { return cell }")
  lines.push("let cell = 4")
  lines.push("println(reader())")
  lines.push("fn shade() { let cell = 8; return cell }")
  lines.push("println(shade())")
  lines.push("println(cell)")
}

fn one(i) {
  let lines = ["#!/usr/bin/env bettersh"]
  let names = []
  let k = 0
  let kind = i % 10
  let nlets = 0
  map_set(rng, "n", 46199 + i)
  let nlets = span(1, 4)
  while k < nlets {
    let name = "v@{ k }"
    lines.push("let @{ name } = @{ span(-20, 40) }")
    names.push(name)
    let k = k + 1
  }
  if kind == 0 { logic(lines, names) }
  else if kind == 1 { branches(lines, names) }
  else if kind == 2 { loops(lines) }
  else if kind == 3 { ranges(lines) }
  else if kind == 4 { arrays(lines) }
  else if kind == 5 { cases(lines, names) }
  else if kind == 6 { functions(lines, names) }
  else if kind == 7 { defaults(lines, names) }
  else if kind == 8 { closures(lines) }
  else { recur(lines) }
  if below(3) == 0 { shared(lines) }
  lines.push("println(@{ names[0] } + @{ names[names.length - 1] })")
  lines.push("println(@{ names[0] } == @{ names[names.length - 1] })")
  lines.push("println(-@{ names[0] })")
  lines.push("println(!@{ names[0] })")
  return "@{ lines.join("\n") }\n"
}

let out = arg(1)
let count = to_int(arg(2))
let i = 0
while i < count {
  writefile("@{ out }/s@{ pad4(i) }.btr", one(i))
  let i = i + 1
}
